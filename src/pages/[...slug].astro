---
// Все посадочные страницы (Ш2, Ш3, Ш10) генерируются из src/data/pages.ts + pages-v2.ts, тексты — из content/<ключ>.json.
import ServicePage from '../templates/ServicePage.astro';
import GeoPage from '../templates/GeoPage.astro';
import QuickPage from '../templates/QuickPage.astro';
import { pageSlugs, pageBySlug } from '../data/pages';

export function getStaticPaths() {
  return pageSlugs().map((slug) => ({ params: { slug } }));
}
// Данные берём по адресу при каждом рендере: в dev новые тексты из content/ видны без перезапуска.
const page = pageBySlug(String(Astro.params.slug))!;
---
{page.tpl === 'Ш2' && <ServicePage page={page} />}
{page.tpl === 'Ш3' && <GeoPage page={page} />}
{page.tpl === 'Ш10' && <QuickPage page={page} />}
