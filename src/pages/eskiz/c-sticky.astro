---
// Прежняя версия эскиза C (липкая схема целиком + 9 карточек этапов). Сохранена для сравнения с /eskiz/c/.
// Эскиз C «Схема»: страница строится вокруг схемы отопления дома (потом здесь будет видео).
// Первый экран: заголовок, оффер, цена, одна кнопка и фрагмент схемы с контуром тёплого пола.
// Сразу под ним схема целиком (компонент HeatingScheme), её этапы ссылаются на разделы страницы.
// Слева через всю страницу идёт «силовая линия» - труба: подача красная, после смешения янтарная, обратка синяя.
import { Image } from 'astro:assets';
import Eskiz from '../../layouts/Eskiz.astro';
import EskizHeader from '../../components/eskiz/EskizHeader.astro';
import EskizFooter from '../../components/eskiz/EskizFooter.astro';
import Zayavka from '../../components/eskiz/Zayavka.astro';
import HeatingScheme from '../../components/eskiz/HeatingScheme.astro';
import { ESKIZ as E, OBJ, HERO, GALLERY, SECTIONS } from '../../lib/eskiz';

const RED = '#E2452B', AMBER = '#F2A23A', BLUE = '#2B6CD9';
// Цвет трубы по разделам: 01-02 подача, 03-04 после узла смешения, 05-06 обратка.
const FLOW = [RED, RED, AMBER, AMBER, BLUE, BLUE];
const S = Object.fromEntries(SECTIONS.map((s, i) => [s.id, { ...s, c: FLOW[i] }]));
const [g1, g2, g3, g4, g5] = GALLERY;
const num = (v: string) => { const m = v.match(/^(от [\d\s ]+)\s(руб\.\/м²)$/); return m ? [m[1], m[2]] : [v, '']; };
// Связь пунктов «Что делаем» с этапами схемы.
const STAGE_OF = [8, 6, 8, null, 7];
const arr = (x: number, y: number, dir: 'r' | 'l' | 'u' | 'd', s = 7) => {
  const p = { r: [[-s, -s], [s, 0], [-s, s]], l: [[s, -s], [-s, 0], [s, s]], u: [[-s, s], [0, -s], [s, s]], d: [[-s, -s], [0, s], [s, -s]] }[dir];
  return p.map(([dx, dy]) => `${x + dx},${y + dy}`).join(' ');
};
---
<Eskiz title="Эскиз C, прежний: липкая схема" description={E.description}>
  <EskizHeader variant="c" name="Эскиз C, прежний: липкая схема" />
  <main class="pc" id="main">

    <section class="hero row" aria-labelledby="h1" style={`--c:${RED}`}>
      <span class="rail rail--hero" aria-hidden="true"></span>
      <div class="hero__text">
        <h1 id="h1">{E.h1}</h1>
        <p class="hero__offer">{E.offer}</p>
        <p class="hero__price"><span class="hero__num">{num(E.priceMain[0].v)[0]}</span> <span class="hero__unit">{num(E.priceMain[0].v)[1]} работа</span></p>
        <p class="hero__sub">{E.priceMain[1].v} {E.priceMain[1].n}</p>
        <a class="btn" href="#zayavka">Рассчитать стоимость</a>
        <p class="hero__area">{E.area}</p>
      </div>
      <figure class="frag">
        <svg viewBox="0 0 520 404" role="img" aria-label="Фрагмент схемы: узел смешения, коллектор тёплого пола и петли">
          <path class="p r" d="M0 70 H120" />
          <polygon class="ar r" points={arr(60, 70, 'r')} />
          <text class="tm" x="4" y="30">от котла, 60-75 °C</text>
          <path class="p a" d="M270 96 V140" />
          <polygon class="ar a" points={arr(270, 118, 'd')} />
          <path class="p a" d="M150 192 V226 H440 V250 H110 V274 H440 V298 H110 V322" />
          <polygon class="ar a" points={arr(290, 226, 'r')} />
          <path class="p b" d="M110 322 H490 V180 H420 M120 180 H70 V376 H0" />
          <polygon class="ar b" points={arr(490, 260, 'u')} />
          <polygon class="ar b" points={arr(70, 290, 'd')} />
          <polygon class="ar b" points={arr(30, 376, 'l')} />
          <path class="p d" d="M420 152 H460 V82 H420" />
          <text class="tm" x="440" y="117" dy=".35em" text-anchor="middle" transform="rotate(-90 440 117)">подмес</text>
          <rect class="eq" x="120" y="44" width="300" height="52" />
          <text class="t" x="164" y="76">Узел смешения</text>
          <g class="n"><circle cx="142" cy="70" r="15" /><text x="142" y="70" dy=".35em">6</text></g>
          <rect class="eq" x="120" y="140" width="300" height="52" />
          <text class="t" x="164" y="172">Коллектор тёплого пола</text>
          <g class="n"><circle cx="142" cy="166" r="15" /><text x="142" y="166" dy=".35em">7</text></g>
          <g class="n"><circle cx="124" cy="354" r="15" /><text x="124" y="354" dy=".35em">8</text></g>
          <text class="t" x="148" y="360">Петли тёплого пола<tspan class="tm" dx="10">35-45 °C</tspan></text>
          <text class="tm" x="4" y="398">в обратку</text>
        </svg>
        <figcaption>Контур тёплого пола: этапы 6-8. <a href="#shema">Вся схема отопления</a></figcaption>
      </figure>
    </section>

    <section class="sec sec--shema row" id="shema" style={`--c:${RED}`}>
      <span class="rail" aria-hidden="true"></span>
      <span class="node node--dot" aria-hidden="true"></span>
      <div class="shema"><HeatingScheme hid="h-shema" /></div>
    </section>

    <section class="sec row" id={S['chto-delaem'].id} style={`--c:${S['chto-delaem'].c}`} aria-labelledby="h-01">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">01</span>
      <div class="sec__head"><h2 id="h-01"><span class="vh">01. </span>Что делаем</h2></div>
      <div class="sec__body">
        <p class="lead">Перед заливкой стяжки проверяем каждый контур давлением. Когда стяжка наберёт прочность, настраиваем коллектор, чтобы комнаты грелись одинаково.</p>
        <ul class="items">
          {E.what.map((w, i) => (
            <li>
              <h3>{w.t}</h3>
              <div>
                <p>{w.d}</p>
                <div class="items__act">
                  <details class="more">
                    <summary>Подробнее</summary>
                    <div class="more__text">{w.more.map((p) => <p>{p}</p>)}</div>
                  </details>
                  {STAGE_OF[i] && <a class="tag" href="#shema" data-go-stage={STAGE_OF[i]}><span class="tag__n">{STAGE_OF[i]}</span>На схеме</a>}
                </div>
              </div>
            </li>
          ))}
        </ul>
        <details class="more more--block">
          <summary>{E.notFor.t}</summary>
          <div class="more__text">
            <p>{E.notFor.lead}</p>
            <ul class="dash">{E.notFor.list.map((x) => <li>{x}</li>)}</ul>
            {E.notFor.after.map((p) => <p>{p}</p>)}
          </div>
        </details>
        <details class="more more--block">
          <summary>Почему тёплый пол делаем как фундамент отопления</summary>
          <div class="more__text">{E.intro.map((p) => <p>{p}</p>)}</div>
        </details>
      </div>
    </section>

    <section class="sec row" id={S.ceny.id} style={`--c:${S.ceny.c}`} aria-labelledby="h-02">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">02</span>
      <div class="sec__head"><h2 id="h-02"><span class="vh">02. </span>Цены</h2></div>
      <div class="sec__body">
        <p class="lead">Цена за м² пола, без стяжки. Стяжку заливает ваша бригада или подрядчик.</p>
        <div class="pv">
          {E.priceMain.map((p) => (
            <div class="pv__item">
              <p class="pv__val"><span class="pv__num">{num(p.v)[0]}</span> <span class="pv__unit">{num(p.v)[1]}</span></p>
              <p class="pv__note">{p.n}</p>
            </div>
          ))}
        </div>
        <h3 class="h3">В стоимость входит</h3>
        <ul class="inc">{E.included.map((x) => <li>{x}</li>)}</ul>
        <h3 class="h3">Отдельные работы</h3>
        <dl class="plist">
          {E.prices.map(([n, u, p]) => (
            <div><dt>{n}</dt><dd><b>{p}</b> <span>за {u}</span></dd></div>
          ))}
        </dl>
        <details class="more more--block">
          <summary>Коротко о цене и сроках</summary>
          <div class="more__text"><p>{E.answer}</p></div>
        </details>
      </div>
    </section>

    <section class="sec sec--mix row" id={S['kak-rabotaem'].id} style={`--c:${S['kak-rabotaem'].c}`} aria-labelledby="h-03">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">03</span>
      <div class="sec__head"><h2 id="h-03"><span class="vh">03. </span>Как работаем</h2></div>
      <div class="sec__body">
        <p class="lead">{E.speed} Шесть шагов от расчёта до первого запуска.</p>
        <ol class="steps">
          {E.steps.map((s, i) => (
            <li><span class="steps__n" aria-hidden="true">{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec row" id={S.obekty.id} style={`--c:${S.obekty.c}`} aria-labelledby="h-04">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">04</span>
      <div class="sec__head"><h2 id="h-04"><span class="vh">04. </span>Объекты</h2></div>
      <div class="sec__body">
        <p class="lead">Так пол выглядит до заливки: эти слои потом не увидеть, поэтому снимаем каждый.</p>
        <div class="gal">
          <figure class="w w--m"><Image src={HERO.src} alt={HERO.alt} widths={[480, 720, 1040]} sizes="(max-width: 720px) 100vw, 520px" /><figcaption>Петли в комнате до заливки стяжки: шаг 150 мм, у наружной стены чаще</figcaption></figure>
          <figure><Image src={g1.src} alt={g1.alt} widths={[320, 480, 640]} sizes="(max-width: 720px) 50vw, 260px" /><figcaption>{g1.alt}</figcaption></figure>
          <figure><Image src={g2.src} alt={g2.alt} widths={[320, 480, 640]} sizes="(max-width: 720px) 50vw, 260px" /><figcaption>{g2.alt}</figcaption></figure>
          <figure class="w w--m"><Image src={g3.src} alt={g3.alt} widths={[480, 720, 1040]} sizes="(max-width: 720px) 100vw, 520px" /><figcaption>{g3.alt}</figcaption></figure>
          <figure class="w"><Image src={g4.src} alt={g4.alt} widths={[320, 480, 720, 1040]} sizes="(max-width: 720px) 50vw, 520px" /><figcaption>{g4.alt}</figcaption></figure>
          <figure><Image src={g5.src} alt={g5.alt} widths={[320, 480, 640]} sizes="(max-width: 720px) 50vw, 260px" /><figcaption>{g5.alt}</figcaption></figure>
        </div>
        <article class="obj">
          <h3>{OBJ.title}</h3>
          <p class="obj__place">{OBJ.place}</p>
          <dl class="obj__facts">{OBJ.facts.map((f) => <div><dt>{f.n}</dt><dd>{f.v}</dd></div>)}</dl>
          <p>{OBJ.text}</p>
          <a class="link" href={OBJ.href}>Посмотреть объект</a>
        </article>
      </div>
    </section>

    <section class="sec sec--ret row" id={S.voprosy.id} style={`--c:${S.voprosy.c}`} aria-labelledby="h-05">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">05</span>
      <div class="sec__head"><h2 id="h-05"><span class="vh">05. </span>Вопросы</h2></div>
      <div class="sec__body">
        <div class="faq">
          {E.faq.map((f) => (
            <details class="more more--faq"><summary>{f.q}</summary><div class="more__text"><p>{f.a}</p></div></details>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec--last row" id={S.zayavka.id} style={`--c:${S.zayavka.c}`} aria-labelledby="h-06">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">06</span>
      <div class="sec__head"><h2 id="h-06"><span class="vh">06. </span>Заявка</h2></div>
      <div class="sec__body">
        <p class="lead">Укажите площадь, и сразу увидите примерную цену. Затем оставьте телефон или почту.</p>
        <Zayavka uid="c" />
      </div>
    </section>
  </main>
  <EskizFooter variant="c" />
</Eskiz>

<style>
  .pc {
    --ink: #0F2340; --ink2: #2C4466; --navy: #1E3A5F; --rule: #B9C6D8; --orange: #E8662A; --rust: #C0480F;
    --red: #E2452B; --amber: #F2A23A; --blue: #2B6CD9;
    --rail: 72px; --pipe: 8px; --gut: clamp(16px, 4vw, 40px);
    color: var(--ink); background: #fff;
    max-width: 1320px; margin: 0 auto; padding: 0 var(--gut);
    --zv-ink: var(--ink); --zv-panel: #fff; --zv-border: 2px solid var(--navy); --zv-field: #fff; --zv-field-ink: var(--ink);
    --zv-field-line: #5B7290; --zv-check: #E8662A; --zv-focus: #2B6CD9; --zv-error: #B8241A;
    --zv-accent: #E8662A; --zv-accent-ink: #0F2340; --zv-accent-hover: #F27B40; --zv-price: #C0480F;
    --zv-rule: 1px solid var(--rule); --zv-radius: 0; --zv-btn-radius: 0;
  }
  :global(html) { scroll-padding-top: 96px; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Сетка: колонка трубы | заголовок | содержимое */
  .row { position: relative; display: grid; grid-template-columns: var(--rail) minmax(0, 4fr) minmax(0, 7fr); column-gap: clamp(24px, 3vw, 48px); }
  /* Силовая линия: труба в цвете потока, на стыках разделов муфта */
  .rail { position: absolute; left: calc(var(--rail) / 2 - var(--pipe) / 2); top: 0; bottom: 0; width: var(--pipe); background: var(--c); }
  .rail::after { content: ''; position: absolute; left: -4px; top: -6px; width: calc(var(--pipe) + 8px); height: 12px; background: var(--navy); }
  .rail--hero { top: 64px; }
  .rail--hero::after { top: -18px; left: -14px; width: calc(var(--pipe) + 28px); height: 28px; background: #fff; border: 4px solid var(--navy); }
  /* перед 03 - узел смешения: подача становится янтарной */
  .sec--mix .rail::after { left: -18px; top: -18px; width: calc(var(--pipe) + 36px); height: 36px; background: #fff; border: 4px solid var(--navy); }
  .sec--mix .rail::before { content: ''; position: absolute; left: -3px; top: -7px; width: calc(var(--pipe) + 6px); height: 14px; z-index: 1; background: linear-gradient(90deg, var(--red) 50%, var(--amber) 50%); }
  /* перед 05 - петли отдали тепло, дальше обратка */
  .sec--ret .rail::after { background: var(--blue); height: 14px; top: -7px; }
  .sec--last .rail { bottom: 72px; }
  .sec--last .rail::before { content: ''; position: absolute; left: calc(var(--pipe) / 2 - 15px); bottom: -24px; width: 0; height: 0; border-left: 15px solid transparent; border-right: 15px solid transparent; border-top: 22px solid var(--blue); }

  .node {
    grid-column: 1; grid-row: 1; justify-self: center; align-self: start; position: sticky; top: 108px; z-index: 2;
    margin-top: clamp(64px, 8.5vw, 112px); display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: #fff; border: 5px solid var(--c); color: var(--ink); font-size: 17px; font-weight: 800;
  }
  .node--dot { width: 24px; height: 24px; background: var(--c); border-color: #fff; box-shadow: 0 0 0 3px var(--c); }

  /* Первый экран */
  .hero { grid-template-columns: var(--rail) minmax(0, 6fr) minmax(0, 5fr); padding: clamp(40px, 6vw, 80px) 0 clamp(56px, 7vw, 96px); align-items: center; }
  .hero__text { grid-column: 2; }
  h1 { font-size: clamp(36px, 4.3vw, 60px); line-height: 1.05; font-weight: 800; letter-spacing: -.025em; text-wrap: balance; max-width: 15ch; }
  .hero__offer { margin-top: 28px; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; font-weight: 500; max-width: 36ch; }
  .hero__price { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .hero__num { font-size: clamp(40px, 4.4vw, 56px); font-weight: 800; color: var(--red); letter-spacing: -.02em; line-height: 1; }
  .hero__unit { font-size: 20px; font-weight: 700; }
  .hero__sub { margin-top: 10px; font-size: 18px; font-weight: 600; color: var(--ink2); }
  .btn { display: inline-flex; align-items: center; justify-content: center; margin-top: 32px; min-height: 60px; padding: 16px 36px; background: var(--orange); color: var(--ink); font-size: 19px; font-weight: 800; text-decoration: none; }
  .btn:hover { background: #F27B40; }
  .hero__area { margin-top: 20px; font-size: 16px; font-weight: 600; color: var(--ink2); }

  .frag { grid-column: 3; margin: 0; padding: clamp(16px, 2vw, 28px); border: 2px solid var(--navy); background: #fff; }
  .frag svg { width: 100%; height: auto; overflow: visible; }
  .frag figcaption { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--rule); font-size: 16px; font-weight: 600; color: var(--ink2); }
  .frag figcaption a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); font-weight: 800; text-underline-offset: 4px; text-decoration-thickness: 2px; text-decoration-color: var(--orange); }
  .frag text { font-family: inherit; }
  .frag .p { fill: none; stroke-width: 6; stroke-linejoin: miter; }
  .frag .p.r { stroke: var(--red); } .frag .p.a { stroke: var(--amber); } .frag .p.b { stroke: var(--blue); }
  .frag .p.d { stroke: var(--blue); stroke-width: 4; stroke-dasharray: 9 7; }
  .frag .ar.r { fill: var(--red); } .frag .ar.a { fill: var(--amber); } .frag .ar.b { fill: var(--blue); }
  .frag .eq { fill: #fff; stroke: var(--navy); stroke-width: 2.5; }
  .frag .t { font-size: 18px; font-weight: 700; fill: var(--ink); }
  .frag .tm { font-size: 16px; font-weight: 600; fill: var(--ink2); }
  .frag .n circle { fill: var(--navy); }
  .frag .n text { fill: #fff; font-size: 16px; font-weight: 800; text-anchor: middle; }

  /* Схема */
  .shema { --hs-top: 80px; grid-column: 2 / -1; grid-row: 1; padding: clamp(56px, 7vw, 96px) 0 clamp(64px, 8vw, 104px); min-width: 0; }
  .sec--shema .node--dot { margin-top: clamp(68px, 7.6vw, 108px); }

  /* Разделы */
  .sec::before { content: ''; grid-column: 2 / -1; grid-row: 1; align-self: start; height: 1px; background: var(--rule); }
  .sec__head, .sec__body { padding-top: clamp(64px, 8.5vw, 112px); padding-bottom: clamp(64px, 8.5vw, 112px); }
  .sec__head { grid-column: 2; grid-row: 1; }
  .sec__head h2 { position: sticky; top: 108px; font-size: clamp(34px, 3.8vw, 52px); line-height: 1.02; font-weight: 800; letter-spacing: -.025em; margin-top: 2px; }
  .sec__head h2::after { content: ''; display: block; width: 72px; height: 6px; margin-top: 18px; background: var(--c); }
  .sec__body { grid-column: 3; grid-row: 1; min-width: 0; max-width: 780px; }
  .lead { font-size: clamp(20px, 1.7vw, 23px); line-height: 1.45; font-weight: 600; max-width: 40ch; margin-bottom: clamp(32px, 4vw, 48px); }
  .h3 { font-size: 22px; font-weight: 800; margin: 48px 0 16px; }

  /* 01 */
  .items { border-bottom: 1px solid var(--rule); }
  .items li { display: grid; grid-template-columns: minmax(0, 240px) minmax(0, 1fr); column-gap: 32px; padding: 22px 0 10px; border-top: 1px solid var(--rule); }
  .items h3 { font-size: 20px; line-height: 1.3; font-weight: 800; padding-top: 2px; }
  .items p { color: var(--ink2); }
  .items__act { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 0 24px; }
  .items__act .more { flex: 1 1 auto; }
  .tag { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--ink); font-size: 16px; font-weight: 700; text-decoration: none; }
  .tag:hover { text-decoration: underline; text-underline-offset: 4px; }
  .tag__n { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--navy); color: #fff; font-size: 14px; font-weight: 800; }
  .more summary { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; cursor: pointer; font-weight: 700; color: var(--ink); list-style: none; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::after { content: ''; width: 12px; height: 12px; flex: none; background: linear-gradient(currentColor 0 0) center / 12px 2px no-repeat, linear-gradient(currentColor 0 0) center / 2px 12px no-repeat; transition: transform .2s; }
  .more[open] summary::after { transform: rotate(45deg); }
  .more summary:hover { text-decoration: underline; text-underline-offset: 4px; }
  .more__text { padding: 4px 0 16px; max-width: 64ch; }
  .more__text p + p, .more__text ul + p, .more__text p + ul { margin-top: 12px; }
  .more--block { border-bottom: 1px solid var(--rule); }
  .more--block summary { min-height: 64px; font-size: 19px; display: flex; justify-content: space-between; }
  .dash li { padding-left: 22px; position: relative; }
