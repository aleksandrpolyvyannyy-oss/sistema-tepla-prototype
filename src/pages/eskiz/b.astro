---
// Эскиз B «Контраст»: светлые и насыщенно-синие секции по очереди, крупные номера разделов,
// между секциями толстый «пульс» - фирменная шкала из шести делений с ручкой термостата,
// которая от раздела к разделу сдвигается от синего к красному. Фото без скруглений, одно на всю ширину.
import { Image } from 'astro:assets';
import Eskiz from '../../layouts/Eskiz.astro';
import EskizHeader from '../../components/eskiz/EskizHeader.astro';
import EskizFooter from '../../components/eskiz/EskizFooter.astro';
import Zayavka from '../../components/eskiz/Zayavka.astro';
import { ESKIZ as E, OBJ, HERO, GALLERY, SECTIONS, SCALE6 } from '../../lib/eskiz';

const [g1, g2, g3, g4, g5] = GALLERY;
const num = (v: string) => { const m = v.match(/^(от [\d\s ]+)\s(руб\.\/м²)$/); return m ? [m[1], m[2]] : [v, '']; };
const sec = (id: string) => { const i = SECTIONS.findIndex((s) => s.id === id); return { ...SECTIONS[i], i }; };
const s1 = sec('chto-delaem'), s2 = sec('ceny'), s3 = sec('kak-rabotaem'), s4 = sec('obekty'), s5 = sec('voprosy'), s6 = sec('zayavka');
---
<Eskiz title="Эскиз B «Контраст»: водяной тёплый пол" description={E.description} theme="#133264">
  <EskizHeader variant="b" />
  <main class="pb" id="main">

    <section class="hero dark" aria-labelledby="h1">
      <div class="hero__in">
        <div class="hero__text">
          <h1 id="h1">{E.h1}</h1>
          <p class="hero__offer">{E.offer}</p>
          <div class="hero__prices">
            <p><span class="hero__num">{num(E.priceMain[0].v)[0]}</span> <span class="hero__unit">{num(E.priceMain[0].v)[1]}</span><span class="hero__n">{E.priceMain[0].n}</span></p>
            <p><span class="hero__num hero__num--2">{num(E.priceMain[1].v)[0]}</span> <span class="hero__unit">{num(E.priceMain[1].v)[1]}</span><span class="hero__n">{E.priceMain[1].n}</span></p>
          </div>
          <a class="btn" href="#zayavka">Рассчитать стоимость</a>
          <p class="hero__area">{E.area}</p>
        </div>
      </div>
      <figure class="hero__photo">
        <Image src={HERO.src} alt={HERO.alt} widths={[480, 720, 960, 1200, 1440]} sizes="(max-width: 960px) 100vw, 46vw" loading="eager" fetchpriority="high" />
      </figure>
    </section>

    {[s1].map((s) => (
      <section class="sb light" id={s.id} aria-labelledby={`h-${s.n}`}>
        <div class="pulse" aria-hidden="true" style={`--k:${SCALE6[s.i]};--pos:${(s.i + 1) / 6 * 100}%`}>{SCALE6.map((c, j) => <i style={`background:${c}`} class:list={{ off: j > s.i }} />)}</div>
        <div class="sb__in">
          <div class="sb__head">
            <p class="sb__num" aria-hidden="true">{s.n}</p>
            <h2 id={`h-${s.n}`}><span class="vh">{s.n}. </span>{s.t}</h2>
            <p class="sb__lead">Перед заливкой стяжки проверяем каждый контур давлением. Потом настраиваем коллектор, чтобы комнаты грелись одинаково.</p>
          </div>
          <div class="sb__body">
            <ul class="what">
              {E.what.map((w) => (
                <li>
                  <h3>{w.t}</h3>
                  <p>{w.d}</p>
                  <details class="more"><summary>Подробнее</summary><div class="more__text">{w.more.map((p) => <p>{p}</p>)}</div></details>
                </li>
              ))}
            </ul>
            <details class="more more--block">
              <summary>{E.notFor.t}</summary>
              <div class="more__text">
                <p>{E.notFor.lead}</p>
                <ul class="dash">{E.notFor.list.map((x) => <li>{x}</li>)}</ul>
                {E.notFor.after.map((p) => <p>{p}</p>)}
              </div>
            </details>
            <details class="more more--block">
              <summary>Почему тёплый пол делаем как фундамент отопления</summary>
              <div class="more__text">{E.intro.map((p) => <p>{p}</p>)}</div>
            </details>
          </div>
        </div>
      </section>
    ))}

    <section class="sb dark" id={s2.id} aria-labelledby={`h-${s2.n}`}>
      <div class="pulse" aria-hidden="true" style={`--k:${SCALE6[s2.i]};--pos:${(s2.i + 1) / 6 * 100}%`}>{SCALE6.map((c, j) => <i style={`background:${c}`} class:list={{ off: j > s2.i }} />)}</div>
      <div class="sb__in">
        <div class="sb__head">
          <p class="sb__num" aria-hidden="true">{s2.n}</p>
          <h2 id={`h-${s2.n}`}><span class="vh">{s2.n}. </span>{s2.t}</h2>
          <p class="sb__lead">Цена за м² пола, без стяжки. Стяжку заливает ваша бригада или подрядчик.</p>
        </div>
        <div class="sb__body">
          <div class="pv">
            {E.priceMain.map((p) => (
              <div><p class="pv__val"><span class="pv__num">{num(p.v)[0]}</span> <span class="pv__unit">{num(p.v)[1]}</span></p><p class="pv__note">{p.n}</p></div>
            ))}
          </div>
          <h3 class="h3">В стоимость входит</h3>
          <ul class="inc">{E.included.map((x) => <li>{x}</li>)}</ul>
          <h3 class="h3">Отдельные работы</h3>
          <dl class="plist">{E.prices.map(([n, u, p]) => <div><dt>{n}</dt><dd><b>{p}</b> <span>за {u}</span></dd></div>)}</dl>
          <details class="more more--block">
            <summary>Коротко о цене и сроках</summary>
            <div class="more__text"><p>{E.answer}</p></div>
          </details>
        </div>
      </div>
    </section>

    <section class="sb light" id={s3.id} aria-labelledby={`h-${s3.n}`}>
      <div class="pulse" aria-hidden="true" style={`--k:${SCALE6[s3.i]};--pos:${(s3.i + 1) / 6 * 100}%`}>{SCALE6.map((c, j) => <i style={`background:${c}`} class:list={{ off: j > s3.i }} />)}</div>
      <div class="sb__in">
        <div class="sb__head">
          <p class="sb__num" aria-hidden="true">{s3.n}</p>
          <h2 id={`h-${s3.n}`}><span class="vh">{s3.n}. </span>{s3.t}</h2>
          <p class="sb__lead">{E.speed} Шесть шагов от расчёта до первого запуска.</p>
        </div>
        <div class="sb__body">
          <ol class="steps">
            {E.steps.map((st, i) => <li><span class="steps__n" aria-hidden="true">{i + 1}</span><div><h3>{st.t}</h3><p>{st.d}</p></div></li>)}
          </ol>
        </div>
      </div>
    </section>

    <section class="sb dark sb--photo" id={s4.id} aria-labelledby={`h-${s4.n}`}>
      <div class="pulse" aria-hidden="true" style={`--k:${SCALE6[s4.i]};--pos:${(s4.i + 1) / 6 * 100}%`}>{SCALE6.map((c, j) => <i style={`background:${c}`} class:list={{ off: j > s4.i }} />)}</div>
      <div class="sb__in sb__in--top">
        <div class="sb__head">
          <p class="sb__num" aria-hidden="true">{s4.n}</p>
          <h2 id={`h-${s4.n}`}><span class="vh">{s4.n}. </span>{s4.t}</h2>
        </div>
        <div class="sb__body sb__body--end">
          <p class="sb__lead">Так пол выглядит до заливки: эти слои потом не увидеть, поэтому снимаем каждый.</p>
        </div>
      </div>
      <figure class="wide">
        <Image src={g2.src} alt={g2.alt} widths={[640, 960, 1440, 1920]} sizes="100vw" />
        <figcaption>{g2.alt}</figcaption>
      </figure>
      <div class="sb__in sb__in--bottom">
        <div class="thumbs">
          {[g1, g3, g4, g5].map((g) => <figure><Image src={g.src} alt={g.alt} widths={[320, 480, 640]} sizes="(max-width: 720px) 50vw, 300px" /><figcaption>{g.alt}</figcaption></figure>)}
        </div>
        <article class="obj">
          <div>
            <h3>{OBJ.title}</h3>
            <p class="obj__place">{OBJ.place}</p>
          </div>
          <div>
            <dl class="obj__facts">{OBJ.facts.map((f) => <div><dt>{f.n}</dt><dd>{f.v}</dd></div>)}</dl>
            <p>{OBJ.text}</p>
            <a class="link" href={OBJ.href}>Посмотреть объект</a>
          </div>
        </article>
      </div>
    </section>

    <section class="sb light" id={s5.id} aria-labelledby={`h-${s5.n}`}>
      <div class="pulse" aria-hidden="true" style={`--k:${SCALE6[s5.i]};--pos:${(s5.i + 1) / 6 * 100}%`}>{SCALE6.map((c, j) => <i style={`background:${c}`} class:list={{ off: j > s5.i }} />)}</div>
      <div class="sb__in">
        <div class="sb__head">
          <p class="sb__num" aria-hidden="true">{s5.n}</p>
          <h2 id={`h-${s5.n}`}><span class="vh">{s5.n}. </span>{s5.t}</h2>
          <p class="sb__lead">Ответы на то, что спрашивают чаще всего до замера.</p>
        </div>
        <div class="sb__body">
          <div class="faq">{E.faq.map((f) => <details class="more more--faq"><summary>{f.q}</summary><div class="more__text"><p>{f.a}</p></div></details>)}</div>
        </div>
      </div>
    </section>

    <section class="sb dark" id={s6.id} aria-labelledby={`h-${s6.n}`}>
      <div class="pulse" aria-hidden="true" style={`--k:${SCALE6[s6.i]};--pos:${(s6.i + 1) / 6 * 100}%`}>{SCALE6.map((c, j) => <i style={`background:${c}`} class:list={{ off: j > s6.i }} />)}</div>
      <div class="sb__in">
        <div class="sb__head">
          <p class="sb__num" aria-hidden="true">{s6.n}</p>
          <h2 id={`h-${s6.n}`}><span class="vh">{s6.n}. </span>{s6.t}</h2>
          <p class="sb__lead">Укажите площадь, и сразу увидите примерную цену. Затем оставьте телефон или почту.</p>
        </div>
        <div class="sb__body">
          <Zayavka uid="b" />
        </div>
      </div>
    </section>
  </main>
  <EskizFooter variant="b" />
</Eskiz>

<style>
  .pb {
    --navy: #133264; --ink: #0F2340; --ink2: #2C4466; --on-dark: #fff; --on-dark2: #D3DEF0;
    --orange: #E8662A; --amber: #F2A23A; --rust: #C0480F; --rule: #B9C6D8; --rule-dark: rgba(255, 255, 255, .28);
    --gut: clamp(16px, 4vw, 40px);
    --zv-ink: var(--ink); --zv-panel: #fff; --zv-border: 0; --zv-field: #fff; --zv-field-ink: var(--ink);
    --zv-field-line: #5B7290; --zv-check: #E8662A; --zv-focus: #2B6CD9; --zv-error: #B8241A;
    --zv-accent: #E8662A; --zv-accent-ink: #0F2340; --zv-accent-hover: #F27B40; --zv-price: #C0480F;
    --zv-rule: 1px solid var(--rule); --zv-radius: 6px; --zv-btn-radius: 6px;
  }
  :global(html) { scroll-padding-top: 88px; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .light { background: #fff; color: var(--ink); }
  .dark { background: var(--navy); color: var(--on-dark); }

  /* Первый экран */
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: min(760px, calc(100vh - 120px)); }
  .hero__in { padding: clamp(48px, 7vw, 104px) var(--gut) clamp(56px, 7vw, 96px); padding-left: max(var(--gut), calc((100vw - 1320px) / 2 + 40px)); display: flex; align-items: center; }
  h1 { font-size: clamp(40px, 5.2vw, 76px); line-height: 1.02; font-weight: 800; letter-spacing: -.03em; text-wrap: balance; max-width: 13ch; }
  .hero__offer { margin-top: 28px; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; font-weight: 500; color: var(--on-dark2); max-width: 36ch; }
  .hero__prices { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 16px 40px; }
  .hero__prices p { display: grid; grid-template-columns: auto auto; align-items: baseline; column-gap: 8px; }
  .hero__num { font-size: clamp(40px, 4vw, 56px); font-weight: 800; line-height: 1; color: var(--amber); letter-spacing: -.02em; white-space: nowrap; }
  .hero__num--2 { color: #fff; }
  .hero__unit { font-size: 19px; font-weight: 700; }
  .hero__n { grid-column: 1 / -1; margin-top: 6px; font-size: 16px; font-weight: 600; color: var(--on-dark2); }
  .btn { display: inline-flex; align-items: center; justify-content: center; margin-top: 40px; min-height: 60px; padding: 16px 36px; background: var(--orange); color: var(--ink); font-size: 19px; font-weight: 800; text-decoration: none; border-radius: 6px; }
  .btn:hover { background: #F27B40; }
  .hero__area { margin-top: 20px; font-size: 16px; font-weight: 600; color: var(--on-dark2); }
  .hero__photo { position: relative; min-height: 100%; }
  .hero__photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Пульс между секциями: шесть делений шкалы, ручка термостата на текущем */
  .pulse { position: relative; display: flex; align-items: center; height: 12px; }
  .pulse i { flex: 1; height: 100%; }
  .pulse i.off { height: 3px; }
  .pulse::after { content: ''; position: absolute; top: 50%; left: clamp(15px, var(--pos), calc(100% - 15px)); width: 30px; height: 30px; transform: translate(-50%, -50%); border-radius: 50%; background: #fff; border: 7px solid var(--k); box-sizing: border-box; box-shadow: 0 0 0 3px var(--navy); }

  /* Секции */
  .sb__in { max-width: 1320px; margin: 0 auto; padding: clamp(72px, 9vw, 128px) var(--gut); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 40px clamp(32px, 5vw, 80px); align-items: start; }
  .sb__num { font-size: clamp(96px, 12vw, 176px); line-height: .8; font-weight: 800; letter-spacing: -.05em; margin-left: -.04em; }
  .sb__head h2 { margin-top: 24px; font-size: clamp(38px, 4.4vw, 60px); line-height: 1.02; font-weight: 800; letter-spacing: -.025em; }
  .sb__lead { margin-top: 24px; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; font-weight: 600; max-width: 32ch; }
  .dark .sb__lead { color: var(--on-dark2); }
  .sb__body { min-width: 0; padding-top: 12px; }
  .h3 { font-size: 22px; font-weight: 800; margin: 48px 0 18px; }

  .more summary { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; cursor: pointer; font-weight: 700; list-style: none; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::after { content: ''; width: 12px; height: 12px; flex: none; background: linear-gradient(currentColor 0 0) center / 12px 2.5px no-repeat, linear-gradient(currentColor 0 0) center / 2.5px 12px no-repeat; transition: transform .2s; }
  .more[open] summary::after { transform: rotate(45deg); }
  .more summary:hover { text-decoration: underline; text-underline-offset: 4px; }
  .more__text { padding: 4px 0 16px; max-width: 64ch; }
  .more__text p + p, .more__text ul + p, .more__text p + ul { margin-top: 12px; }
  .more--block { border-bottom: 2px solid currentColor; }
  .more--block summary { display: flex; justify-content: space-between; min-height: 64px; font-size: 19px; }
  .dash li { padding-left: 22px; position: relative; }
  .dash li::before { content: ''; position: absolute; left: 0; top: .8em; width: 12px; height: 2px; background: currentColor; }

  /* 01 */
  .what { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 32px; margin-bottom: 40px; }
  .what li { border-top: 6px solid var(--navy); padding-top: 18px; }
  .what h3 { font-size: 21px; font-weight: 800; line-height: 1.3; margin-bottom: 6px; }
  .what p { color: var(--ink2); }

  /* 02 */
  .pv { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 32px; }
  .pv > div { border-top: 6px solid var(--amber); padding-top: 18px; }
  .pv__val { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .pv__num { font-size: clamp(44px, 4.6vw, 64px); line-height: 1; font-weight: 800; color: var(--amber); letter-spacing: -.02em; white-space: nowrap; }
  .pv__unit { font-size: 19px; font-weight: 700; }
  .pv__note { margin-top: 8px; font-weight: 600; color: var(--on-dark2); }
  .inc { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 32px; }
  .inc li { position: relative; padding-left: 26px; }
  .inc li::before { content: ''; position: absolute; left: 0; top: .45em; width: 13px; height: 13px; background: var(--orange); }
  .plist div { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; padding: 14px 0; border-top: 1px solid var(--rule-dark); }
  .plist div:last-child { border-bottom: 1px solid var(--rule-dark); }
  .plist dd { margin: 0; text-align: right; white-space: nowrap; }
  .plist b { color: var(--amber); font-weight: 800; }
  .plist span { color: var(--on-dark2); font-size: 16px; }
  .sb__body > .more--block:first-of-type { margin-top: 24px; }

  /* 03 */
  .steps { display: grid; grid-template-columns: 1fr 1fr; gap: 36px 32px; }
  .steps li { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 16px; }
  .steps__n { display: grid; place-items: center; width: 56px; height: 56px; background: var(--navy); color: #fff; font-size: 24px; font-weight: 800; }
  .steps h3 { font-size: 20px; font-weight: 800; line-height: 1.3; margin: 2px 0 6px; }
  .steps p { color: var(--ink2); }

  /* 04 */
  .sb__in--top { padding-bottom: 48px; align-items: end; }
  .sb__body--end .sb__lead { margin-top: 0; }
  .wide { margin: 0; }
  .wide :global(img) { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; object-position: center 60%; }
  .wide figcaption { max-width: 1320px; margin: 0 auto; padding: 12px var(--gut) 0; font-size: 16px; color: var(--on-dark2); }
  .sb__in--bottom { grid-template-columns: minmax(0, 1fr); padding-top: 48px; }
  .thumbs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .thumbs :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .thumbs figcaption { margin-top: 8px; font-size: 16px; line-height: 1.4; color: var(--on-dark2); }
  .obj { background: #fff; color: var(--ink); padding: clamp(22px, 3vw, 40px); border-top: 8px solid var(--orange); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 0 clamp(24px, 4vw, 56px); }
  .obj .link { margin-top: 16px; }
  .obj h3 { font-size: clamp(22px, 2.2vw, 28px); font-weight: 800; line-height: 1.25; }
  .obj__place { margin-top: 4px; color: var(--ink2); font-weight: 600; }
  .obj__facts { display: grid; gap: 10px; margin: 0 0 18px; padding: 0 0 16px; border-bottom: 1px solid var(--rule); }
  .obj__facts div { display: flex; justify-content: space-between; gap: 16px; }
  .obj__facts dt { color: var(--ink2); font-weight: 600; }
  .obj__facts dd { margin: 0; font-weight: 800; text-align: right; }
  .link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; color: var(--ink); font-weight: 800; text-underline-offset: 5px; text-decoration-thickness: 2px; text-decoration-color: var(--orange); }

  /* 05 */
  .faq { border-top: 6px solid var(--navy); }
  .more--faq { border-bottom: 1px solid var(--rule); }
  .more--faq summary { display: flex; justify-content: space-between; gap: 24px; min-height: 76px; padding: 16px 0; font-size: 20px; line-height: 1.35; }
  .more--faq .more__text { color: var(--ink2); padding-bottom: 24px; }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero__photo { min-height: 0; }
    .hero__photo :global(img) { position: static; aspect-ratio: 4 / 3; }
    .sb__in, .sb__in--bottom, .obj { grid-template-columns: 1fr; }
    .obj { gap: 20px; }
    .sb__in--top { padding-bottom: 32px; }
    .thumbs { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 720px) {
    .hero__in { padding-top: 40px; padding-bottom: 48px; }
    h1 { font-size: clamp(34px, 9.6vw, 40px); max-width: none; }
    .hero__offer { margin-top: 18px; font-size: 18px; }
    .hero__prices { margin-top: 26px; gap: 18px 28px; }
    .hero__num { font-size: 40px; }
    .btn { width: 100%; margin-top: 30px; }
    .sb__in { padding-top: 64px; padding-bottom: 64px; gap: 28px; }
    .sb__num { font-size: 96px; }
    .sb__head h2 { margin-top: 16px; font-size: 38px; }
    .sb__lead { font-size: 19px; margin-top: 16px; }
    .sb__body { padding-top: 0; }
    .what, .pv, .inc, .steps { grid-template-columns: 1fr; }
    .what { gap: 28px; }
    .plist div { flex-direction: column; gap: 2px; }
    .plist dd { text-align: left; }
    .steps li { grid-template-columns: 48px minmax(0, 1fr); }
    .steps__n { width: 48px; height: 48px; font-size: 21px; }
    .wide :global(img) { aspect-ratio: 4 / 3; }
    .more--faq summary { font-size: 18px; }
    .more--block summary { font-size: 18px; }
    .pulse { height: 10px; }
    .pulse::after { width: 26px; height: 26px; border-width: 6px; }
