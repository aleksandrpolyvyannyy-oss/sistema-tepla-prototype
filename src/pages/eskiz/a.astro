---
// Эскиз A «Чертёж»: белый фон, тёмно-синий текст, вертикальная линия-шкала слева через всю страницу,
// номера разделов «пристёгнуты» к линии, заголовок раздела сбоку, содержимое справа. Прямые углы.
import { Image } from 'astro:assets';
import Eskiz from '../../layouts/Eskiz.astro';
import EskizHeader from '../../components/eskiz/EskizHeader.astro';
import EskizFooter from '../../components/eskiz/EskizFooter.astro';
import Zayavka from '../../components/eskiz/Zayavka.astro';
import { ESKIZ as E, OBJ, HERO, GALLERY, SECTIONS, SCALE6 } from '../../lib/eskiz';

const S = Object.fromEntries(SECTIONS.map((s, i) => [s.id, { ...s, c: SCALE6[i] }]));
const [g1, g2, g3, g4, g5] = GALLERY;
const num = (v: string) => { const m = v.match(/^(от [\d\s ]+)\s(руб\.\/м²)$/); return m ? [m[1], m[2]] : [v, '']; };
---
<Eskiz title="Эскиз A «Чертёж»: водяной тёплый пол" description={E.description}>
  <EskizHeader variant="a" />
  <main class="pa" id="main">

    <section class="hero row" aria-labelledby="h1">
      <span class="rail rail--hero" aria-hidden="true"></span>
      <div class="hero__text">
        <h1 id="h1">{E.h1}</h1>
        <p class="hero__offer">{E.offer}</p>
        <p class="hero__price"><span class="hero__num">{num(E.priceMain[0].v)[0]}</span> <span class="hero__unit">{num(E.priceMain[0].v)[1]} работа</span></p>
        <p class="hero__sub">{E.priceMain[1].v} {E.priceMain[1].n}</p>
        <a class="btn" href="#zayavka">Рассчитать стоимость</a>
        <p class="hero__area">{E.area}</p>
      </div>
      <figure class="hero__photo">
        <Image src={HERO.src} alt={HERO.alt} widths={[480, 720, 960, 1200]} sizes="(max-width: 900px) 100vw, 520px" loading="eager" fetchpriority="high" />
      </figure>
    </section>

    <section class="sec row" id={S['chto-delaem'].id} style={`--c:${S['chto-delaem'].c}`} aria-labelledby="h-01">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">01</span>
      <div class="sec__head"><h2 id="h-01"><span class="vh">01. </span>Что делаем</h2></div>
      <div class="sec__body">
        <p class="lead">Перед заливкой стяжки проверяем каждый контур давлением. Когда стяжка наберёт прочность, настраиваем коллектор, чтобы комнаты грелись одинаково.</p>
        <ul class="items">
          {E.what.map((w) => (
            <li>
              <h3>{w.t}</h3>
              <p>{w.d}</p>
              <details class="more">
                <summary>Подробнее</summary>
                <div class="more__text">{w.more.map((p) => <p>{p}</p>)}</div>
              </details>
            </li>
          ))}
        </ul>
        <details class="more more--block">
          <summary>{E.notFor.t}</summary>
          <div class="more__text">
            <p>{E.notFor.lead}</p>
            <ul class="dash">{E.notFor.list.map((x) => <li>{x}</li>)}</ul>
            {E.notFor.after.map((p) => <p>{p}</p>)}
          </div>
        </details>
        <details class="more more--block">
          <summary>Почему тёплый пол делаем как фундамент отопления</summary>
          <div class="more__text">{E.intro.map((p) => <p>{p}</p>)}</div>
        </details>
      </div>
    </section>

    <section class="sec row" id={S.ceny.id} style={`--c:${S.ceny.c}`} aria-labelledby="h-02">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">02</span>
      <div class="sec__head"><h2 id="h-02"><span class="vh">02. </span>Цены</h2></div>
      <div class="sec__body">
        <p class="lead">Цена за м² пола, без стяжки. Стяжку заливает ваша бригада или подрядчик.</p>
        <div class="pv">
          {E.priceMain.map((p) => (
            <div class="pv__item">
              <p class="pv__val"><span class="pv__num">{num(p.v)[0]}</span> <span class="pv__unit">{num(p.v)[1]}</span></p>
              <p class="pv__note">{p.n}</p>
            </div>
          ))}
        </div>
        <h3 class="h3">В стоимость входит</h3>
        <ul class="inc">{E.included.map((x) => <li>{x}</li>)}</ul>
        <h3 class="h3">Отдельные работы</h3>
        <dl class="plist">
          {E.prices.map(([n, u, p]) => (
            <div><dt>{n}</dt><dd><b>{p}</b> <span>за {u}</span></dd></div>
          ))}
        </dl>
        <details class="more more--block">
          <summary>Коротко о цене и сроках</summary>
          <div class="more__text"><p>{E.answer}</p></div>
        </details>
      </div>
    </section>

    <section class="sec row" id={S['kak-rabotaem'].id} style={`--c:${S['kak-rabotaem'].c}`} aria-labelledby="h-03">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">03</span>
      <div class="sec__head"><h2 id="h-03"><span class="vh">03. </span>Как работаем</h2></div>
      <div class="sec__body">
        <p class="lead">{E.speed} Шесть шагов от расчёта до первого запуска.</p>
        <ol class="steps">
          {E.steps.map((s, i) => (
            <li><span class="steps__n" aria-hidden="true">{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec row" id={S.obekty.id} style={`--c:${S.obekty.c}`} aria-labelledby="h-04">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">04</span>
      <div class="sec__head"><h2 id="h-04"><span class="vh">04. </span>Объекты</h2></div>
      <div class="sec__body">
        <p class="lead">Так пол выглядит до заливки: эти слои потом не увидеть, поэтому снимаем каждый.</p>
        <div class="gal">
          {[g1, g2, g3].map((g) => (
            <figure><Image src={g.src} alt={g.alt} widths={[360, 540, 720]} sizes="(max-width: 900px) 50vw, 260px" /><figcaption>{g.alt}</figcaption></figure>
          ))}
          <figure class="gal__wide"><Image src={g4.src} alt={g4.alt} widths={[540, 800, 1080]} sizes="(max-width: 900px) 100vw, 520px" /><figcaption>{g4.alt}</figcaption></figure>
          <figure><Image src={g5.src} alt={g5.alt} widths={[360, 540, 720]} sizes="(max-width: 900px) 50vw, 260px" /><figcaption>{g5.alt}</figcaption></figure>
        </div>
        <article class="obj">
          <h3>{OBJ.title}</h3>
          <p class="obj__place">{OBJ.place}</p>
          <dl class="obj__facts">{OBJ.facts.map((f) => <div><dt>{f.n}</dt><dd>{f.v}</dd></div>)}</dl>
          <p>{OBJ.text}</p>
          <a class="link" href={OBJ.href}>Посмотреть объект</a>
        </article>
      </div>
    </section>

    <section class="sec row" id={S.voprosy.id} style={`--c:${S.voprosy.c}`} aria-labelledby="h-05">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">05</span>
      <div class="sec__head"><h2 id="h-05"><span class="vh">05. </span>Вопросы</h2></div>
      <div class="sec__body">
        <div class="faq">
          {E.faq.map((f) => (
            <details class="more more--faq"><summary>{f.q}</summary><div class="more__text"><p>{f.a}</p></div></details>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec--last row" id={S.zayavka.id} style={`--c:${S.zayavka.c}`} aria-labelledby="h-06">
      <span class="rail" aria-hidden="true"></span>
      <span class="node" aria-hidden="true">06</span>
      <div class="sec__head"><h2 id="h-06"><span class="vh">06. </span>Заявка</h2></div>
      <div class="sec__body">
        <p class="lead">Укажите площадь, и сразу увидите примерную цену. Затем оставьте телефон или почту.</p>
        <Zayavka uid="a" />
      </div>
    </section>
  </main>
  <EskizFooter variant="a" />
</Eskiz>

<style>
  .pa {
    --ink: #0F2340; --ink2: #2C4466; --rule: #B9C6D8; --orange: #E8662A; --rust: #C0480F;
    --rail: 72px; --gut: clamp(16px, 4vw, 40px);
    color: var(--ink); background: #fff;
    max-width: 1320px; margin: 0 auto; padding: 0 var(--gut);
    /* форма заявки */
    --zv-ink: var(--ink); --zv-panel: #fff; --zv-border: 2px solid var(--ink); --zv-field: #fff; --zv-field-ink: var(--ink);
    --zv-field-line: #5B7290; --zv-check: #E8662A; --zv-focus: #2B6CD9; --zv-error: #B8241A;
    --zv-accent: #E8662A; --zv-accent-ink: #0F2340; --zv-accent-hover: #F27B40; --zv-price: #E8662A;
    --zv-rule: 1px solid var(--rule); --zv-radius: 0; --zv-btn-radius: 0;
  }
  :global(html) { scroll-padding-top: 96px; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Сетка: колонка линии | заголовок | содержимое */
  .row { position: relative; display: grid; grid-template-columns: var(--rail) minmax(0, 4fr) minmax(0, 7fr); column-gap: clamp(24px, 3vw, 48px); }
  .rail { position: absolute; left: calc(var(--rail) / 2 - 1.5px); top: 0; bottom: 0; width: 3px; background: var(--c, var(--ink)); }
  /* деления шкалы справа от линии */
  .rail::after { content: ''; position: absolute; left: 3px; top: 0; bottom: 0; width: 9px; background: repeating-linear-gradient(to bottom, var(--c, var(--ink)) 0 2px, transparent 2px 24px); }
  .rail--hero { top: 56px; width: 3px; background: var(--ink); }
  .rail--hero::before { content: ''; position: absolute; left: -6.5px; top: -8px; width: 16px; height: 16px; border-radius: 50%; background: #2B6CD9; }
  .sec--last .rail { bottom: 64px; }
  .sec--last .rail::before { content: ''; position: absolute; left: -10.5px; bottom: -22px; width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 5px solid var(--c); }

  .node {
    grid-column: 1; grid-row: 1; justify-self: center; align-self: start; position: sticky; top: 104px; z-index: 1;
    margin-top: clamp(72px, 9vw, 120px); display: grid; place-items: center; width: 52px; height: 34px;
    background: #fff; border: 3px solid var(--c); color: var(--ink); font-size: 16px; font-weight: 800; letter-spacing: .02em;
  }

  /* Первый экран */
  .hero { grid-template-columns: var(--rail) minmax(0, 7fr) minmax(0, 5fr); padding: clamp(40px, 6vw, 88px) 0 clamp(64px, 8vw, 112px); align-items: start; }
  .hero__text { grid-column: 2; padding-top: 24px; }
  h1 { font-size: clamp(36px, 4.3vw, 60px); line-height: 1.05; font-weight: 800; letter-spacing: -.025em; text-wrap: balance; max-width: 15ch; }
  .hero__offer { margin-top: 28px; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; font-weight: 500; max-width: 36ch; }
  .hero__price { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .hero__num { font-size: clamp(40px, 4.4vw, 56px); font-weight: 800; color: var(--orange); letter-spacing: -.02em; line-height: 1; }
  .hero__unit { font-size: 20px; font-weight: 700; }
  .hero__sub { margin-top: 10px; font-size: 18px; font-weight: 600; color: var(--ink2); }
  .btn { display: inline-flex; align-items: center; justify-content: center; margin-top: 32px; min-height: 60px; padding: 16px 36px; background: var(--orange); color: var(--ink); font-size: 19px; font-weight: 800; text-decoration: none; border: 0; }
  .btn:hover { background: #F27B40; }
  .hero__area { margin-top: 20px; font-size: 16px; font-weight: 600; color: var(--ink2); }
  .hero__photo { grid-column: 3; justify-self: end; width: min(100%, 540px); }
  .hero__photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }

  /* Разделы */
  .sec { padding: 0; }
  .sec::before { content: ''; grid-column: 2 / -1; grid-row: 1; align-self: start; height: 1px; background: var(--rule); }
  .sec__head, .sec__body { padding-top: clamp(64px, 8.5vw, 112px); padding-bottom: clamp(64px, 8.5vw, 112px); }
  .sec__head { grid-column: 2; grid-row: 1; }
  .sec__head h2 { position: sticky; top: 104px; font-size: clamp(34px, 3.8vw, 52px); line-height: 1.02; font-weight: 800; letter-spacing: -.025em; margin-top: -6px; }
  .sec__body { grid-column: 3; grid-row: 1; min-width: 0; max-width: 780px; }
  .lead { font-size: clamp(20px, 1.7vw, 23px); line-height: 1.45; font-weight: 600; max-width: 40ch; margin-bottom: clamp(32px, 4vw, 48px); }
  .h3 { font-size: 22px; font-weight: 800; margin: 48px 0 16px; }

  /* 01 Что делаем */
  .items { border-bottom: 1px solid var(--rule); }
  .items li { display: grid; grid-template-columns: minmax(0, 240px) minmax(0, 1fr); column-gap: 32px; padding: 22px 0 14px; border-top: 1px solid var(--rule); }
  .items h3 { font-size: 20px; line-height: 1.3; font-weight: 800; padding-top: 2px; }
  .items p { color: var(--ink2); }
  .items .more { grid-column: 2; }
  .more summary { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; cursor: pointer; font-weight: 700; color: var(--ink); list-style: none; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::after { content: ''; width: 12px; height: 12px; flex: none; background: linear-gradient(currentColor 0 0) center / 12px 2px no-repeat, linear-gradient(currentColor 0 0) center / 2px 12px no-repeat; transition: transform .2s; }
  .more[open] summary::after { transform: rotate(45deg); }
  .more summary:hover { text-decoration: underline; text-underline-offset: 4px; }
  .more__text { padding: 4px 0 16px; max-width: 64ch; }
  .more__text p + p, .more__text ul + p, .more__text p + ul { margin-top: 12px; }
  .more--block { border-bottom: 1px solid var(--rule); }
  .more--block summary { min-height: 64px; font-size: 19px; display: flex; justify-content: space-between; }
  .dash li { padding-left: 22px; position: relative; }
  .dash li::before { content: ''; position: absolute; left: 0; top: .8em; width: 12px; height: 2px; background: var(--ink); }

  /* 02 Цены */
  .pv { display: grid; grid-template-columns: 1fr 1fr; border-top: 3px solid var(--ink); border-bottom: 1px solid var(--rule); }
  .pv__item { padding: 24px 24px 24px 0; }
  .pv__item + .pv__item { padding-left: 24px; border-left: 1px solid var(--rule); }
  .pv__val { display: grid; gap: 8px; }
  .pv__num { font-size: clamp(40px, 4.2vw, 56px); line-height: 1; font-weight: 800; color: var(--orange); letter-spacing: -.02em; white-space: nowrap; }
  .pv__unit { font-size: 19px; font-weight: 700; }
  .pv__note { margin-top: 8px; font-weight: 600; }
  .inc { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 32px; }
  .inc li { position: relative; padding-left: 26px; }
  .inc li::before { content: ''; position: absolute; left: 0; top: .5em; width: 12px; height: 12px; background: var(--orange); }
  .plist div { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; padding: 14px 0; border-top: 1px solid var(--rule); }
  .plist div:last-child { border-bottom: 1px solid var(--rule); }
  .plist dd { margin: 0; text-align: right; white-space: nowrap; }
  .plist b { color: var(--rust); font-weight: 800; }
  .plist span { color: var(--ink2); font-size: 16px; }
  .sec__body > .more--block:first-of-type { margin-top: 32px; }
  .sec__body .items + .more--block { margin-top: 0; }

  /* 03 Как работаем */
  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 44px 40px; }
  .steps li { border-top: 3px solid var(--ink); padding-top: 18px; }
  .steps__n { display: grid; place-items: center; width: 40px; height: 40px; border: 2px solid var(--ink); font-weight: 800; font-size: 18px; margin-bottom: 14px; }
  .steps h3 { font-size: 20px; font-weight: 800; line-height: 1.3; margin-bottom: 6px; }
  .steps p { color: var(--ink2); }

  /* 04 Объекты */
  .gal { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 16px; }
  .gal figure :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .gal .gal__wide { grid-column: span 2; }
  .gal .gal__wide :global(img) { aspect-ratio: 3 / 2; }
  .gal figcaption { margin-top: 8px; font-size: 16px; line-height: 1.4; color: var(--ink2); }
  .obj { margin-top: 48px; border: 2px solid var(--ink); padding: clamp(20px, 3vw, 32px); }
  .obj h3 { font-size: 22px; font-weight: 800; line-height: 1.3; }
  .obj__place { margin-top: 4px; color: var(--ink2); font-weight: 600; }
  .obj__facts { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1fr) minmax(0, 1.6fr); gap: 16px; margin: 20px 0; padding: 16px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .obj__facts dt { font-size: 16px; color: var(--ink2); font-weight: 600; }
  .obj__facts dd { margin: 0; font-weight: 800; }
  .link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; color: var(--ink); font-weight: 800; text-underline-offset: 5px; text-decoration-thickness: 2px; text-decoration-color: var(--orange); }

  /* 05 Вопросы */
  .faq { border-top: 3px solid var(--ink); }
  .more--faq { border-bottom: 1px solid var(--rule); }
  .more--faq summary { display: flex; justify-content: space-between; gap: 24px; min-height: 72px; padding: 14px 0; font-size: 20px; line-height: 1.35; font-weight: 700; }
  .more--faq .more__text { color: var(--ink2); padding-bottom: 24px; }

  /* Планшет и телефон: линия остаётся слева, заголовок над содержимым */
  @media (max-width: 1100px) {
    .row { grid-template-columns: var(--rail) minmax(0, 1fr); }
    .hero__text, .hero__photo, .sec__head, .sec__body { grid-column: 2; }
    .hero__photo { grid-row: 2; justify-self: start; margin-top: 48px; width: 100%; }
    .hero__photo :global(img) { aspect-ratio: 3 / 2; }
    .sec__head { grid-row: 1; padding-bottom: 0; }
    .sec__head h2 { position: static; }
    .sec__body { grid-row: 2; padding-top: 24px; }
    .node { position: static; }
  }
  @media (max-width: 720px) {
    .pa { --rail: 44px; padding-left: 4px; padding-right: 16px; }
    .row { column-gap: 12px; }
    .node { width: 40px; height: 30px; font-size: 14px; border-width: 2px; margin-top: 64px; }
    .rail::after { width: 6px; }
    .hero { padding-top: 32px; }
    .hero__text { padding-top: 8px; }
    h1 { font-size: clamp(32px, 9vw, 38px); max-width: none; }
    .hero__offer { margin-top: 18px; font-size: 18px; }
    .hero__price { margin-top: 22px; }
    .btn { width: 100%; margin-top: 24px; }
    .hero__photo { margin-top: 36px; }
    .hero__photo :global(img) { aspect-ratio: 4 / 3; }
    .sec__body { padding-bottom: 56px; }
    .sec__head { padding-top: 56px; padding-bottom: 0; }
    .sec__head h2 { font-size: 34px; }
    .sec__body { padding-top: 16px; }
    .lead { font-size: 19px; margin-bottom: 28px; }
    .items li { grid-template-columns: 1fr; }
    .items .more { grid-column: 1; }
    .items h3 { margin-bottom: 4px; }
    .pv { grid-template-columns: 1fr; }
    .pv__item + .pv__item { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); }
    .inc { grid-template-columns: 1fr; }
    .plist div { flex-direction: column; gap: 2px; }
    .plist dd { text-align: left; }
    .steps { grid-template-columns: 1fr; gap: 28px; }
    .gal { grid-template-columns: 1fr 1fr; gap: 16px 12px; }
    .gal .gal__wide { grid-column: 1 / -1; order: 5; }
    .gal .gal__wide :global(img) { aspect-ratio: 4 / 3; }
    .obj__facts { grid-template-columns: 1fr; gap: 8px; }
    .more--faq summary { font-size: 18px; }
    .more--block summary { font-size: 18px; }
    .sec--last .rail { bottom: 40px; }
  }
  @media (prefers-reduced-motion: reduce) { .more summary::after { transition: none; } }
</style>
