---
// Ш1 — главная. Порядок блоков: ПЛАН-САЙТ.md раздел 4 + уточнения ЗАПУСК-ПРИОРИТЕТЫ.md раздел 3.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DirectAnswer from '../components/DirectAnswer.astro';
import Section from '../components/Section.astro';
import Packages from '../components/Packages.astro';
import Quiz from '../components/Quiz.astro';
import ObjectsGrid from '../components/ObjectsGrid.astro';
import Steps from '../components/Steps.astro';
import Guarantees from '../components/Guarantees.astro';
import SampleEstimate from '../components/SampleEstimate.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import LeadSection from '../components/LeadSection.astro';
import { photo, PHOTO_ALT } from '../lib/photos';
import { PKG_HEATING, STEPS_MONTAGE } from '../data/common';
import { GEO_AREAS } from '../data/site';
import Prose from '../components/Prose.astro';
import { contentFor } from '../lib/content';
import { pageBySlug, href } from '../data/pages';

// Тексты главной можно перекрыть файлом content/index.json (формат — PRAVKI-V2.md, п. 5).
const c = contentFor('/');

const main = [
  { t: 'Отопление', href: '/otoplenie/', img: '14', price: 'от 380 000 ₽ за дом 100 м²', d: 'Котельная, тёплый пол, радиаторы — газ или без газа.',
    links: [['/otoplenie/kotelnaya/', 'Котельная'], ['/otoplenie/teplyj-pol/', 'Тёплые полы'], ['/otoplenie/radiatory/', 'Радиаторы'], ['/otoplenie/avtomatika/', 'Автоматика']] },
  { t: 'Водоснабжение', href: '/vodosnabzhenie/', img: '42', price: 'от 3 500 ₽ за точку', d: 'Ввод воды от скважины, фильтрация и разводка по дому.',
    links: [['/vodosnabzhenie/vnutrennee/', 'Внутреннее водоснабжение и водоотведение'], ['/vodosnabzhenie/naruzhnoe/', 'Наружное водоснабжение'], ['/vodosnabzhenie/filtraciya/', 'Система фильтрации']] },
  { t: 'Канализация', href: '/kanalizaciya/', img: '09', price: 'от 145 000 ₽ за септик с монтажом', d: 'Станции очистки и септики с установкой, внутренняя канализация.',
    links: [['/kanalizaciya/yunilos-astra/', 'Юнилос Астра'], ['/kanalizaciya/topas/', 'Топас'], ['/kanalizaciya/evrolos/', 'Евролос'], ['/kanalizaciya/#podbor', 'Подобрать станцию']] },
  { t: 'Запуск газовых котлов', href: '/zapusk-gazovyh-kotlov/', img: '24', price: 'от 7 000 ₽', d: 'Первый пуск газового котла, пусконаладка, акт для гарантии.',
    links: [['/zapusk-gazovyh-kotlov/', 'Первый пуск и пусконаладка'], ['/zapusk-gazovyh-kotlov/opressovka/', 'Опрессовка'], ['/zapusk-gazovyh-kotlov/balansirovka/', 'Балансировка']] },
  { t: 'Сервис', href: '/servis/', img: '16', price: 'от 6 000 ₽ за выезд', d: 'Обслуживание котельных, отопления, водоснабжения и септиков по графику.',
    links: [['/servis/obsluzhivanie-kotelnyh/', 'Обслуживание котельных'], ['/servis/obsluzhivanie-otopleniya/', 'Обслуживание систем отопления'], ['/servis/obsluzhivanie-vodosnabzheniya/', 'Обслуживание водоснабжения'], ['/servis/obsluzhivanie-septikov/', 'Обслуживание септиков']] },
  { t: 'Всё одним договором', href: '/otoplenie-i-vodosnabzhenie/', img: '40', price: 'от 780 000 ₽ за дом 150 м²', d: 'Отопление, вода и канализация одним договором и одной бригадой.',
    links: [['/otoplenie-i-vodosnabzhenie/', 'Отопление и водоснабжение одним договором'], ['/ceny/', 'Цены и сметы-примеры'], ['/obekty/', 'Объекты']] },
];
// SEO-страницы вне меню — ссылки с главной.
const seo = ['otoplenie/kotelnaya/ustanovka-gazovogo-kotla', 'otoplenie/gazovoe', 'otoplenie/bez-gaza', 'otoplenie/leningradskaya-oblast', 'vodosnabzhenie/vnutrennee/razvodka-vody', 'vodosnabzhenie/vnutrennee/vnutrennyaya-kanalizaciya']
  .map((s) => pageBySlug(s)!).filter(Boolean);

const faq = [
  { q: 'Сколько стоит монтаж отопления частного дома?', a: 'Для дома 100 м² — от 380 тыс ₽, 150 м² — от 520 тыс ₽, 200 м² — от 690 тыс ₽ с газовым котлом и оборудованием. Точную цену даём сметой через 24 часа после бесплатного замера и фиксируем в договоре.' },
  { q: 'Сколько длится монтаж отопления?', a: 'Для дома 100–150 м² — 10–25 рабочих дней в зависимости от состава: котельная, радиаторы, тёплый пол. Сушка стяжки тёплого пола в срок монтажа не входит.' },
  { q: 'Работаете ли вы в Ленинградской области?', a: 'Да, во всех районах области. Замер бесплатный в радиусе 60 км от КАД, дальше — 40 ₽ за км. Чаще всего работаем во Всеволожском, Гатчинском, Ломоносовском, Тосненском и Приозерском районах.' },
  { q: 'Вы подключаете газ?', a: 'Подключение к газу и пуск газа выполняет газораспределительная организация. Мы монтируем котельную по проекту газоснабжения, а после пуска газа выполняем первый пуск и настройку котла — у нас есть разрешение на эти работы.' },
  { q: 'Как устроена оплата?', a: 'Три платежа: 70% — аванс на материалы и оборудование с доставкой, 20% — после основного монтажа, 10% — после пусконаладки и сдачи. Работы в аванс не входят.' },
  { q: 'Какая гарантия?', a: '3 года на монтажные работы по договору, на оборудование — гарантия производителя. Первый пуск оформляем актом, чтобы гарантия на котёл действовала.' },
  { q: 'Можно сделать отопление и воду одним договором?', a: 'Да, и это выгоднее на 10–15%: общая котельная и бойлерная, одна бригада, один график и одна гарантия. Наружную канализацию, септик и ввод воды можно включить в ту же смету.' },
  { q: 'Запускаете системы, смонтированные другими?', a: 'Да. Сначала осматриваем и опрессовываем систему, фиксируем замечания в акте, при необходимости исправляем, затем запускаем и настраиваем.' },
];
---
<Base title={c?.title ?? 'Монтаж отопления частного дома в СПб и ЛО — Система тепла'} description={c?.description ?? 'Отопление, котельные, тёплый пол, водоснабжение и канализация в частных домах Санкт-Петербурга и Ленобласти. Смета за 24 часа, цена в договоре, гарантия 3 года.'} quiz>
  <Hero h1={c?.h1 ?? 'Монтаж отопления частного дома в СПб и Ленобласти'} offer={c?.offer ?? 'Котельная, тёплый пол, радиаторы и вода по дому — одним договором. Смета за 24 часа, цена фиксируется в договоре.'} img="44" eyebrow={c?.eyebrow ?? 'Инженерные сети частного дома'} price={c?.priceFrom ?? 'от 380 000 ₽ за дом 100 м²'} primary={{ href: '#raschet', label: 'Рассчитать стоимость' }} season
    trust={[['24 ч', 'смета после замера'], ['3 года', 'гарантия на работы'], ['60 км', 'от КАД — замер бесплатно']]} />
  <DirectAnswer label="Коротко о нас" text={c?.answer ?? '«Система тепла» монтирует отопление, котельные, водоснабжение и канализацию в частных домах Санкт-Петербурга и Ленинградской области. Отопление дома 150 м² с газовым котлом, тёплым полом и радиаторами стоит от 520 тыс ₽ с оборудованием и занимает 15–25 рабочих дней; вместе с разводкой воды и канализации — от 780 тыс ₽. Первый пуск газового котла делаем за один выезд, смонтированные системы берём на сервис.'} />

  <Section id="uslugi" eyebrow="Услуги" title="Инженерные сети дома: что мы делаем" lead="Отопление, вода и канализация, запуск котлов и сервис — одной компанией.">
    <div class="grid grid--3">
      {main.map((m) => (
        <article class="svc">
          <a href={m.href} tabindex="-1" aria-hidden="true"><Image src={photo(m.img)} alt={PHOTO_ALT[m.img]} widths={[400, 640]} sizes="(max-width: 620px) 100vw, 380px" /></a>
          <div class="svc__body">
            <h3><a href={m.href} style="text-decoration:none;color:inherit">{m.t}</a></h3>
            <p>{m.d}</p>
            <ul style="list-style:none;padding:0;margin:0 0 16px;display:grid;gap:6px;font-size:15px">
              {m.links.map(([h, l]) => <li><a href={h}>{l}</a></li>)}
            </ul>
            <div class="svc__foot"><b>{m.price}</b><a class="svc__arrow" href={m.href} aria-label={`Подробнее: ${m.t}`}>→</a></div>
          </div>
        </article>
      ))}
    </div>
    <div class="minor-line">
      <span>Также по теме:</span>
      {seo.map((p) => <a class="chip" href={href(p.slug)}>{p.name}</a>)}
    </div>
  </Section>

  <Prose intro={c?.intro} sections={c?.sections} updated={c?.updated} />

  <Section id="ceny" variant="tint" eyebrow="Пакеты и цены" title="Сколько стоит отопление дома" lead="Цены «от» с оборудованием. Полный прайс — на странице цен.">
    <Packages items={PKG_HEATING} />
    <div class="mt-40"><SampleEstimate heading="h3" /></div>
    <p class="mt-24"><a class="btn btn--ghost" href="/ceny/">Все цены и прайс работ</a></p>
  </Section>

  <Quiz preset="otoplenie" />

  <ObjectsGrid title="Наши объекты" variant="plain" />

  <Guarantees id="pochemu-my" eyebrow="Почему мы и гарантии" title="Один подрядчик — одна гарантия" lead="Не нужно стыковать сантехников с отопленцами и выяснять, кто виноват. Цена, сроки и гарантия — в договоре.">
    <Fragment slot="before">
      <div class="one one--dark">
        <div class="one__node">Отопление<small>котельная, пол, радиаторы</small></div>
        <span class="one__op">+</span>
        <div class="one__node">Водоснабжение<small>разводка, водоподготовка</small></div>
        <span class="one__op">+</span>
        <div class="one__node">Канализация<small>внутренняя и наружная</small></div>
        <span class="one__op">=</span>
        <div class="one__node one__res">Один договор<small>один график, одна гарантия 3 года</small></div>
      </div>
      <p class="center" style="margin:20px 0 36px"><a class="on-dark" href="/otoplenie-i-vodosnabzhenie/">Отопление и водоснабжение одним договором →</a></p>
      <h3 class="guar__caption">Что мы фиксируем в договоре</h3>
    </Fragment>
  </Guarantees>

  <Section id="etapy" eyebrow="Этапы и сроки" title="7 шагов от заявки до тёплого дома" lead="Дом 100–150 м² — 10–25 рабочих дней монтажа; срок каждого этапа — в графике к договору.">
    <Steps items={STEPS_MONTAGE} />
  </Section>

  <Reviews variant="tint" />

  <Section eyebrow="География" title="Работаем в СПб и по всей Ленобласти">
    <div class="split">
      <div class="map-stub"><div><b>Карта зоны работ</b>Яндекс Карта подключится после согласия на cookie. До этого — статичная схема.</div></div>
      <div>
        <p>Замер бесплатно в радиусе 60 км от КАД. Чаще всего работаем здесь:</p>
        <div class="places" style="margin-bottom:20px">{GEO_AREAS.map((g) => <span>{g}</span>)}</div>
        <a class="btn btn--ghost" href="/otoplenie/leningradskaya-oblast/">Отопление в Ленинградской области</a>
      </div>
    </div>
  </Section>

  <Faq items={c?.faq ?? faq} variant="tint" />
  <LeadSection />
</Base>
