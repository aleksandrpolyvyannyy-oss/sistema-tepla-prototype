---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
const planned = [
  ['Октябрь', 'Котельная с газовым котлом: требования 2026'], ['Октябрь', 'Сколько стоит отопление дома 100–200 м² по нашим объектам'], ['Октябрь', 'Тёплый пол или радиаторы'],
  ['Ноябрь', 'Первый пуск газового котла: что проверяет специалист и сколько это стоит'], ['Ноябрь', 'Не работает котёл: причины и что делать'],
  ['Ноябрь', 'Опрессовка и балансировка: зачем нужны после монтажа'], ['Ноябрь', 'Разводка воды в доме от скважины: схема и цена'],
];
---
<Base title="Статьи об отоплении частного дома — «Система тепла»" description="Статьи инженеров «Система тепла» об отоплении, котельных, тёплом поле и водоснабжении частного дома." crumbs={[{ href: '/blog/', label: 'Статьи' }]}>
  <section class="hero" style="padding-bottom:0">
    <div class="wrap">
      <div class="eyebrow">Блог · очередь 2</div>
      <h1>Статьи об отоплении частного дома</h1>
      <p class="hero__offer">Пишут инженеры компании — с цифрами по нашим объектам. В прототипе одна статья как образец шаблона Ш11.</p>
    </div>
  </section>
  <Section>
    <div class="grid grid--3">
      <a class="card card--link" href="/blog/chem-otaplivat-dom-bez-gaza/"><span class="tag tag--ok">Опубликовано</span><h3 style="margin-top:10px">Чем отапливать дом, если нет газа</h3><p class="muted">Электрокотёл, тепловой насос, дрова: монтаж и расходы для дома 150 м².</p><span class="card__more">Читать →</span></a>
      {planned.map(([m, t]) => <div class="card"><span class="tag tag--q2">План · {m}</span><h3 style="margin-top:10px">{t}</h3></div>)}
    </div>
  </Section>
</Base>
