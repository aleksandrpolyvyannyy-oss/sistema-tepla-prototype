---
// Ш11 — статья блога (образец шаблона; блог — очередь 2, статья из плана на октябрь).
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Compare from '../../components/Compare.astro';
import ObjCard from '../../components/ObjCard.astro';
import LeadSection from '../../components/LeadSection.astro';
import { OBJECTS } from '../../data/objects';
const toc = [['otvet', 'Короткий ответ'], ['varianty', 'Варианты и расходы'], ['elektro', 'Электрокотёл: когда выгоден'], ['nasos', 'Тепловой насос'], ['tverdoe', 'Твёрдое топливо'], ['vybor', 'Как выбрать']];
const ld = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Чем отапливать дом, если нет газа', datePublished: '2026-10-05', dateModified: '2026-10-05',
  author: { '@type': 'Person', name: 'Руководитель проектов «Система тепла»', jobTitle: 'Инженер-теплотехник' },
  publisher: { '@id': 'https://sistema-tepla.ru/#org' }, inLanguage: 'ru',
};
const objs = OBJECTS.filter((o) => o.tags.includes('bez-gaza') || o.tags.includes('teplyj-pol')).slice(0, 2);
---
<Base title="Чем отапливать дом, если нет газа: варианты и расходы в 2026" description="Сравнение отопления без газа для дома 150 м² в Ленобласти: электрокотёл, тепловой насос, твердотопливный котёл. Стоимость монтажа и расходы в месяц." crumbs={[{ href: '/blog/', label: 'Статьи' }, { href: '/blog/chem-otaplivat-dom-bez-gaza/', label: 'Чем отапливать дом без газа' }]} jsonld={[ld]}>
  <article class="section" style="padding-top:32px">
    <div class="wrap prose">
      <div class="eyebrow">Статья · образец шаблона Ш11</div>
      <h1 style="font-size:clamp(28px,4vw,40px)">Чем отапливать дом, если нет газа?</h1>
      <p class="muted" style="font-size:14px">Обновлено 05.10.2026 · 7 минут чтения</p>
      <div class="answer" id="otvet"><div><span class="answer__label">Короткий ответ</span><p>Для дома 150 м² без газа в Ленобласти чаще всего выбирают электрокотёл с тёплым полом: монтаж от 320 тыс ₽, расходы 12–18 тыс ₽ в месяц зимой. Тепловой насос в монтаже вдвое дороже, зато расходы в 2–3 раза ниже. Твердотопливный котёл дешевле в эксплуатации, но требует ежедневной загрузки.</p></div></div>
      <nav class="card mt-24" aria-label="Оглавление"><b>Содержание</b><ol style="margin:8px 0 0">{toc.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol></nav>
      <h2 id="varianty">Варианты и расходы</h2>
      <p>Сравнили четыре варианта для утеплённого дома 150 м² по нашим объектам 2025–2026 годов.</p>
      <Compare head={['Вариант', 'Монтаж, от', 'Расход в месяц зимой*', 'Особенности']} rows={[
        ['Электрокотёл', '320 000 ₽', '12–18 тыс ₽', 'Нужно 12–15 кВт мощности'],
        ['Электрокотёл + теплоаккумулятор', '390 000 ₽', '8–12 тыс ₽', 'Ночной тариф'],
        ['Тепловой насос', '650 000 ₽', '5–8 тыс ₽', 'Лучше с тёплым полом'],
        ['Твердотопливный котёл', '360 000 ₽', '6–9 тыс ₽', 'Загрузка 1–2 раза в сутки'],
      ]} />
      <h2 id="elektro">Электрокотёл: когда выгоден</h2>
      <p>Если газ обещают провести в ближайшие 2–3 года, электрокотёл — самое разумное временное решение: он недорогой, а котельная сразу собирается с местом под газовый котёл. Важно заранее узнать лимит выделенной мощности: для дома 150 м² нужно 12–15 кВт с учётом бойлера.</p>
      <h2 id="nasos">Тепловой насос</h2>
      <p>Насос «воздух–вода» переносит тепло с улицы в дом и тратит в 3–4 раза меньше электричества, чем электрокотёл. Работает до −25 °C, но в сильный мороз ему нужен электрический догрев. Окупается за 6–9 лет при постоянном проживании.</p>
      <h2 id="tverdoe">Твёрдое топливо</h2>
      <p>Дрова и пеллеты дешевле электричества, но котёл нужно загружать и чистить. Почти всегда ставим его в паре с электрокотлом: он держит тепло, когда хозяев нет дома.</p>
      <h2 id="vybor">Как выбрать</h2>
      <ul><li>Узнайте лимит мощности и планы по газификации посёлка.</li><li>Посчитайте теплопотери дома — от них зависит всё остальное.</li><li>Делайте тёплый пол: с ним любой источник тепла работает экономичнее.</li></ul>
      <div class="card mt-40" style="display:flex;gap:16px;align-items:center">
        <div class="team__ph" style="width:88px;margin:0;flex-shrink:0">Фото</div>
        <div><b>Автор: руководитель проектов</b><br /><span class="muted">Инженер-теплотехник, 12 лет в проектировании и монтаже отопления частных домов. Имя и фото — после фотосессии.</span></div>
      </div>
      <h2>Связанные услуги</h2>
      <div class="places"><a class="chip" href="/otoplenie/bez-gaza/">Отопление без газа</a><a class="chip" href="/otoplenie/teplyj-pol/">Водяной тёплый пол</a><a class="chip" href="/otoplenie/kotelnaya/">Монтаж котельной</a></div>
    </div>
  </article>
  <Section variant="tint" eyebrow="Объекты по теме" title="Как это сделано у наших клиентов">
    <div class="grid grid--2">{objs.map((o) => <ObjCard o={o} />)}</div>
  </Section>
  <LeadSection title="Подберём отопление для дома без газа" uid="lead-blog" />
</Base>
