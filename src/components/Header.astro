---
// Шапка (PRAVKI-V2.md, п. 1): подпись «ИНЖЕНЕРНЫЕ СЕТИ», основное меню из шести вкладок,
// «Цены / Объекты / Отзывы / Контакты» — в верхней тонкой строке (на телефоне — внизу мобильного меню).
// Подсветка: вкладка раздела активна на странице раздела и на любой его подстранице, включая SEO-страницы вне меню;
// в выпадающем списке отмечена текущая подуслуга (или подуслуга-родитель текущей страницы).
import Logo from './Logo.astro';
import { NAV, TOP_LINKS, SITE, cleanPath, inSection, navIndexFor } from '../data/site';
const path = cleanPath(Astro.url.pathname);
const calc = Astro.props.quiz ? '#raschet' : '/ceny/#raschet';
const activeIdx = navIndexFor(path);
// aria-current: «page» — это сама страница, «true» — страница внутри раздела.
const cur = (href: string) => (path === href ? 'page' : inSection(path, href) ? 'true' : undefined);
// Пункт выпадающего списка: точное совпадение или самый длинный адрес-предок текущей страницы (кроме «весь раздел»).
// Название вкладки — ссылка на страницу раздела; стрелка рядом раскрывает подразделы (на компьютере список открывается и по наведению).
const hubOf = (item: (typeof NAV)[number]) => item.href ?? item.children?.find((c) => c.note)?.href ?? item.children?.[0]?.href ?? '/';
function subCurrent(children: { href: string; note?: string }[], href: string) {
  if (path === href) return 'page';
  if (children.some((c) => c.href === path)) return undefined;
  const best = children.filter((c) => !c.note && inSection(path, c.href)).sort((a, b) => b.href.length - a.href.length)[0];
  return best?.href === href ? 'true' : undefined;
}
---
<div class="topbar">
  <div class="wrap">
    <span class="topbar__info">{SITE.area} · {SITE.hours}</span>
    <nav class="topbar__links" aria-label="Дополнительное меню">
      {TOP_LINKS.map((l) => <a href={l.href} aria-current={cur(l.href)}>{l.label}</a>)}
      <a class="topbar__phone" href={SITE.phoneHref}>{SITE.phone}</a>
    </nav>
  </div>
</div>
<header class="header" data-header>
  <div class="wrap header__row">
    <a class="brand" href="/" aria-label="Система тепла — на главную">
      <Logo />
      <span>
        <span class="brand__name"><b>СИСТЕМА</b> <i>ТЕПЛА</i></span>
        <span class="brand__sub">ИНЖЕНЕРНЫЕ СЕТИ</span>
      </span>
    </a>
    <a class="header__phone" href={SITE.phoneHref}><b>{SITE.phone}</b><span>{SITE.hours}</span></a>
    <a class="btn btn--primary header__cta" href={calc}>Рассчитать</a>
    <a class="header__mobile-phone" href={SITE.phoneHref} aria-label={`Позвонить ${SITE.phone}`}>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
    </a>
    <button class="burger" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="main-nav" data-burger><span></span><span></span><span></span></button>
  </div>
  <div class="header__navrow"><div class="wrap">
    <nav class="nav" id="main-nav" aria-label="Основное меню">
      <ul class="nav__list">
        {NAV.map((item, i) => (item.groups || item.children) ? (
          <li class:list={['nav__item', 'nav__item--split', { 'is-active': i === activeIdx }]} data-sub data-active={i === activeIdx ? '' : undefined}>
            <div class="nav__head">
              <a class="nav__link" href={hubOf(item)} aria-current={i === activeIdx ? (path === hubOf(item) ? 'page' : 'true') : undefined}>{item.label}</a>
              <button class="nav__toggle" type="button" aria-expanded="false" aria-controls={`sub-${i}`} aria-label={`Подразделы: ${item.label}`}>
                <svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </button>
            </div>
            {item.groups ? (
              <div class="nav__sub nav__sub--cols" id={`sub-${i}`}>
                <div class="nav__cols">
                  {item.groups.map((g) => (
                    <div class="nav__col">
                      <div class="nav__col-title">{g.title}</div>
                      <ul>
                        {g.links.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                      </ul>
                    </div>
                  ))}
                </div>
                {item.cta && <a class="btn btn--primary nav__cta" href={item.cta.href}>{item.cta.label}</a>}
              </div>
            ) : (
              <ul class="nav__sub" id={`sub-${i}`}>
                {item.children!.filter((c) => !c.note).map((c) => (
                  <li><a href={c.href} aria-current={subCurrent(item.children!, c.href)}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ) : (
          <li class:list={['nav__item', { 'is-active': i === activeIdx }]}>
            <a class="nav__link" href={item.href} aria-current={i === activeIdx ? (path === item.href ? 'page' : 'true') : undefined}>{item.label}</a>
          </li>
        ))}
        {TOP_LINKS.map((l, i) => (
          <li class:list={['nav__item', 'nav__item--m', { 'nav__item--m-first': i === 0, 'is-active': !!cur(l.href) }]}>
            <a class="nav__link" href={l.href} aria-current={cur(l.href)}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div></div>
  <div class="scale"></div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const burger = header.querySelector<HTMLButtonElement>('[data-burger]')!;
  const desktop = matchMedia('(min-width: 1360px)');
  const closeSubs = (except?: Element) => header.querySelectorAll('[data-sub].is-open').forEach((o) => {
    if (o === except) return;
    o.classList.remove('is-open');
    o.querySelector('button')!.setAttribute('aria-expanded', 'false');
  });
  const setMenu = (open: boolean) => {
    // Меню занимает весь экран ниже шапки, где бы шапка ни находилась (над ней плашка прототипа).
    header.style.setProperty('--menu-top', `${Math.max(0, header.getBoundingClientRect().bottom)}px`);
    header.classList.toggle('is-menu', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
    document.documentElement.classList.toggle('menu-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    closeSubs();
    // На телефоне раздел, в котором находится посетитель, сразу раскрыт: видно и вкладку, и текущую подуслугу.
    const active = open ? header.querySelector<HTMLElement>('[data-sub][data-active]') : null;
    if (active) {
      active.classList.add('is-open');
      active.querySelector('button')!.setAttribute('aria-expanded', 'true');
    }
  };
  burger.addEventListener('click', () => setMenu(!header.classList.contains('is-menu')));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (header.classList.contains('is-menu')) { setMenu(false); burger.focus(); }
    closeSubs();
  });
  desktop.addEventListener('change', (e) => { if (e.matches) setMenu(false); });
  header.querySelectorAll<HTMLElement>('[data-sub]').forEach((li) => {
    const btn = li.querySelector('button')!;
    btn.addEventListener('click', () => {
      const open = !li.classList.contains('is-open');
      closeSubs(li);
      li.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) closeSubs();
  });
  header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
</script>
