---
// Смета-пример (MVP №10). PDF появится после подготовки обезличенных смет заказчиком — пока HTML-превью.
import type { QuizKind } from '../data/pages';
interface Props { kind?: QuizKind; heading?: 'h2' | 'h3' }
const { kind = 'otoplenie', heading = 'h2' } = Astro.props;
const H = heading;
const ALL = {
  otoplenie: { t: 'Отопление дома 150 м², газобетон, газовый котёл', rows: [['Котельная: котёл 24 кВт, бойлер 200 л, обвязка', '238 400'], ['Тёплый пол 1 этаж, 72 м², 8 контуров', '168 900'], ['Радиаторы 2 этаж, 7 шт, коллекторная разводка', '96 300'], ['Автоматика, датчики, управление со смартфона', '31 800'], ['Пусконаладка, опрессовка, балансировка', '24 000']], sum: '559 400' },
  voda: { t: 'Вода и канализация, дом 150 м², 2 санузла', rows: [['Узел ввода, фильтры, коллекторы', '38 700'], ['Разводка воды, 14 точек, PE-Xa', '61 200'], ['Канализация, 11 точек, стояк с шумоизоляцией', '42 500'], ['Инсталляции, 2 шт', '29 800'], ['Опрессовка и проливка', '6 000']], sum: '178 200' },
  kanalizaciya: { t: 'Станция очистки на 5 пользователей, глинистый грунт', rows: [['Станция биологической очистки с принудительным отводом', '142 000'], ['Земляные работы, песчаная подушка, обратная засыпка', '24 000'], ['Наружная канализация 110 мм с утеплением, 8 м', '17 600'], ['Подключение электропитания', '6 000'], ['Монтаж, пуск и инструктаж', '14 000']], sum: '203 600' },
  servis: { t: 'Плановое обслуживание, дом 160 м²', rows: [['Обслуживание котельной: насосы, баки, группа безопасности', '8 000'], ['Чистка фильтров и грязевиков, 4 шт', '3 200'], ['Обслуживание водоснабжения, замена картриджей', '6 000'], ['Проверка автоматики и настройка погодной кривой', '2 500']], sum: '19 700' },
  zapusk: { t: 'Запуск отопления, дом 180 м²', rows: [['Осмотр системы и опрессовка с актом', '6 000'], ['Первый пуск газового котла', '7 000'], ['Балансировка тёплого пола, 9 контуров', '5 400'], ['Настройка погодной автоматики', '5 000']], sum: '23 400' },
  kompleks: { t: 'Отопление + вода + канализация, дом 150 м²', rows: [['Котельная и бойлерная с водоподготовкой', '312 600'], ['Тёплый пол и радиаторы', '265 200'], ['Водоснабжение, 14 точек', '99 900'], ['Канализация, 11 точек', '72 300'], ['Пусконаладка всех систем', '30 000']], sum: '780 000' },
};
const d = ALL[kind];
---
<div class="estimate">
  <div>
    <div class="eyebrow">Прозрачная смета</div>
    <H class="estimate__title">Смета-пример без формы и звонков</H>
    <p class="muted">Так выглядит смета, которую вы получите через 24 часа после замера: оборудование, материалы и работы отдельными строками, итог фиксируется в договоре.</p>
    <p><span class="btn btn--ghost" aria-disabled="true" title="Файл появится после подготовки обезличенных смет">Скачать образец сметы в PDF</span></p>
    <p class="table-note">Прототип: PDF подключается после согласования образца. Цифры — пример.</p>
  </div>
  <div class="estimate__doc" aria-label="Превью сметы">
    <b style="color:var(--navy-900)">Смета № 0417 · {d.t}</b>
    <table style="margin-top:12px">
      <thead><tr><th>Позиция</th><th>₽</th></tr></thead>
      <tbody>
        {d.rows.map(([a, b]) => <tr><td>{a}</td><td class="num">{b}</td></tr>)}
        <tr class="total"><td>Итого, цена фиксируется в договоре</td><td class="num">{d.sum}</td></tr>
      </tbody>
    </table>
  </div>
</div>
