<script>
  const NS = 'http://www.w3.org/2000/svg';
  // Подпути, которые стартуют не из точки на другой трубе, а когда вода дойдёт до конца указанной:
  // этап 5 - выход обратки с коллектора радиаторов, этап 8 - выход обратки с коллектора пола и подмес,
  // этап 9 - участок от гидрострелки в котёл. Номера - порядок подпутей этапа в разметке.
  const AFTER: Record<number, Record<number, number>> = { 5: { 4: 3 }, 8: { 2: 1, 3: 1 }, 9: { 1: 0 } };
  const clamp = (v: number, a = 0, b = 1) => (v < a ? a : v > b ? b : v);
  // Доля прокрутки этапа, за которую прорисовываются его трубы.
  const T0 = 0.05, TD = 0.8;
  const stageT = (p: number, k: number) => clamp((p - (k - 1) - T0) / TD);
  let uid = 0;

  type Pt = [number, number];
  type Sub = { el: SVGPathElement; mk: SVGPathElement | null; L: number; pts: Pt[]; cum: number[]; t0: number; a: number; b: number; u: number };
  type Arr = { el: SVGPolygonElement; st: number; tau: number; on: boolean | null };
  type Grp = { el: SVGGElement; st: number[]; min: number };
  type Lay = { svg: SVGSVGElement; subs: Sub[][]; arrs: Arr[]; grps: Grp[]; camP: number[]; camV: number[]; vbH: number };

  // Трубы схемы - ломаные из команд M/H/V в абсолютных координатах.
  const parse = (d: string): Pt[][] => {
    const out: Pt[][] = [];
    let cur: Pt[] = [], x = 0, y = 0, m: RegExpExecArray | null;
    const re = /([MHV])\s*(-?[\d.]+)(?:[\s,]+(-?[\d.]+))?/g;
    while ((m = re.exec(d))) {
      if (m[1] === 'M') { x = +m[2]; y = +m[3]; cur = [[x, y]]; out.push(cur); }
      else if (m[1] === 'H') { x = +m[2]; cur.push([x, y]); }
      else { y = +m[2]; cur.push([x, y]); }
    }
    return out;
  };
  // Расстояние вдоль ломаной до точки на ней, -1 если точка не на трубе.
  const along = (s: { pts: Pt[]; cum: number[] }, [px, py]: Pt, tol = 1.5) => {
    for (let i = 1; i < s.pts.length; i++) {
      const [x1, y1] = s.pts[i - 1], [x2, y2] = s.pts[i];
      if (y1 === y2 && Math.abs(py - y1) <= tol && px >= Math.min(x1, x2) - 4 && px <= Math.max(x1, x2) + 4)
        return s.cum[i - 1] + clamp(Math.abs(px - x1), 0, Math.abs(x2 - x1));
      if (x1 === x2 && Math.abs(px - x1) <= tol && py >= Math.min(y1, y2) - 4 && py <= Math.max(y1, y2) + 4)
        return s.cum[i - 1] + clamp(Math.abs(py - y1), 0, Math.abs(y2 - y1));
    }
    return -1;
  };
  const mk = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>) => {
    const el = document.createElementNS(NS, tag);
    for (const k in attrs) el.setAttribute(k, String(attrs[k]));
    return el;
  };

  // Готовит раскладку к прорисовке: делит трубы на подпути, добавляет серые контуры, маски и метки потока.
  const build = (svg: SVGSVGElement): Lay => {
    const vb = svg.viewBox.baseVal;
    const defs = mk('defs', {});
    const ghost = mk('g', { class: 'gh', 'aria-hidden': 'true' });
    svg.prepend(defs, ghost);
    const subs: Sub[][] = Array.from({ length: 10 }, () => []);
    const arrs: Arr[] = [];
    const grps: Grp[] = [...svg.querySelectorAll<SVGGElement>('g[data-stage]')].map((el) => {
      const st = (el.dataset.stage ?? '').split(' ').map(Number);
      const k = Math.max(...st);
      el.querySelectorAll<SVGPathElement>(':scope > path.p').forEach((path) => {
        const dashed = path.classList.contains('d');
        parse(path.getAttribute('d') ?? '').forEach((pts) => {
          const d = 'M' + pts.map((p) => p.join(' ')).join(' L');
          const cum = [0];
          for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.abs(pts[i][0] - pts[i - 1][0]) + Math.abs(pts[i][1] - pts[i - 1][1]));
          const el2 = path.cloneNode() as SVGPathElement;
          el2.setAttribute('d', d);
          path.before(el2);
          ghost.append(mk('path', { class: dashed ? 'gp gp--d' : 'gp', d }));
          let L = 0;
          try { L = el2.getTotalLength(); } catch { L = 0; }
          if (!(L > 0)) L = cum[cum.length - 1];
          let m: SVGPathElement | null = null;
          if (dashed) {
            // Пунктир прорисовываем маской, чтобы не сбить его собственный рисунок штрихов.
            const id = `hsm${++uid}`;
            const mask = mk('mask', { id, maskUnits: 'userSpaceOnUse', x: -20, y: -20, width: vb.width + 40, height: vb.height + 40 });
            m = mk('path', { d, fill: 'none', stroke: '#fff', 'stroke-width': 14, 'stroke-dasharray': `${L} ${L + 40}` });
            mask.append(m);
            defs.append(mask);
            el2.setAttribute('mask', `url(#${id})`);
          } else {
            el2.style.strokeDasharray = `${L} ${L + 40}`;
            const fm = mk('path', { class: 'fm', d });
            el2.after(fm);
          }
          subs[k].push({ el: el2, mk: m, L, pts, cum, t0: 0, a: 0, b: 1, u: -1 });
        });
        path.remove();
      });
      el.querySelectorAll<SVGPolygonElement>(':scope > polygon.ar').forEach((a) => arrs.push({ el: a, st: k, tau: 0.5, on: null }));
      return { el, st, min: Math.min(...st) };
    });
    // Время прихода воды в начало каждого подпути при постоянной скорости внутри этапа.
    subs.forEach((S, k) => {
      if (!S.length) return;
      const end: number[] = [];
      S.forEach((s, j) => {
        let t0 = 0;
        const af = AFTER[k]?.[j];
        if (af !== undefined && S[af]) t0 = end[af];
        else for (let i = 0; i < j; i++) { const d = along(S[i], s.pts[0]); if (d >= 0) { t0 = S[i].t0 + d; break; } }
        s.t0 = t0; end[j] = t0 + s.L;
      });
      const T = Math.max(...end);
      S.forEach((s, j) => { s.a = s.t0 / T; s.b = end[j] / T; });
      (S as Sub[] & { T?: number }).T = T;
    });
    // Стрелка загорается, когда вода проходит её место.
    arrs.forEach((a) => {
      const P = (a.el.getAttribute('points') ?? '').trim().split(/\s+/).map((q) => q.split(',').map(Number));
      const c: Pt = [P.reduce((v, q) => v + q[0], 0) / P.length, P.reduce((v, q) => v + q[1], 0) / P.length];
      const S = subs[a.st] as Sub[] & { T?: number };
      for (const s of S) { const d = along(s, c, 3); if (d >= 0) { a.tau = (s.t0 + d) / (S.T ?? 1); break; } }
    });
    // Камера для узкого экрана: за номером этапа, на 9 этапе вслед за обраткой снизу вверх.
    const cy = (n: number) => Number(svg.querySelector(`.n[data-go="${n}"] circle`)?.getAttribute('cy') ?? 0);
    const camP = [0, 1, 2, 3, 4, 5, 6, 7, 8, 8.85];
    const camV = [1, 2, 3, 4, 5, 6, 7, 8, 7, 1].map(cy);
    return { svg, subs, arrs, grps, camP, camV, vbH: vb.height };
  };

  const cam = (lay: Lay, p: number) => {
    const P = lay.camP, V = lay.camV;
    if (p <= P[0]) return V[0];
    for (let i = 1; i < P.length; i++) if (p <= P[i]) return V[i - 1] + (V[i] - V[i - 1]) * (p - P[i - 1]) / (P[i] - P[i - 1]);
    return V[V.length - 1];
  };

  document.querySelectorAll<HTMLElement>('[data-hs]').forEach((root) => {
    const ctrl = root.querySelector<HTMLElement>('[data-ctrl]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const playT = root.querySelector<HTMLElement>('[data-play-t]')!;
    const nums = [...root.querySelectorAll<HTMLButtonElement>('.hs__num')];
    const lis = [...root.querySelectorAll<HTMLElement>('[data-cap]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.classList.add('js');
    ctrl.hidden = false;
    const press = (n: number | null) => nums.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.go) === n)));

    if (reduce) {
      // Без анимации: схема целиком, номер подсвечивает этап и прокручивает к его описанию.
      let timer = 0;
      const set = (n: number | null) => {
        if (n) root.dataset.active = String(n); else delete root.dataset.active;
        root.querySelectorAll<SVGElement>('[data-stage]').forEach((g) => g.classList.toggle('on', !!n && (g.dataset.stage ?? '').split(' ').includes(String(n))));
        lis.forEach((li) => li.classList.toggle('on', Number(li.dataset.cap) === n));
        press(n);
      };
      const stop = () => {
        if (timer) window.clearInterval(timer);
        timer = 0;
        play.setAttribute('aria-pressed', 'false');
        playT.textContent = 'Показать весь цикл';
      };
      play.addEventListener('click', () => {
        if (timer) { stop(); set(null); return; }
        let n = 1;
        set(n);
        play.setAttribute('aria-pressed', 'true');
        playT.textContent = 'Остановить';
        timer = window.setInterval(() => { n += 1; if (n > 9) { stop(); set(null); return; } set(n); }, 4000);
      });
      root.addEventListener('click', (e) => {
        const t = (e.target as Element).closest<HTMLElement | SVGElement>('[data-go]');
        if (!t || !root.contains(t)) return;
        stop();
        const n = Number(t.dataset.go);
        const off = root.dataset.active === String(n);
        set(off ? null : n);
        if (!off) lis[n - 1]?.scrollIntoView({ block: 'nearest' });
      });
      document.querySelectorAll<HTMLElement>('[data-go-stage]').forEach((a) =>
        a.addEventListener('click', () => { stop(); set(Number(a.dataset.goStage)); }));
      return;
    }

    // ---------- Прокрутка ведёт по схеме ----------
    root.classList.add('sc');
    hint.textContent = 'Прокручивайте страницу: вода пройдёт по схеме от котла по обеим веткам и вернётся в котёл. Номер переносит к этапу, «Показать весь цикл» прокрутит сам.';
    const scrolly = root.querySelector<HTMLElement>('[data-scrolly]')!;
    const pin = root.querySelector<HTMLElement>('[data-pin]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const barN = root.querySelector<HTMLElement>('[data-bar-n]')!;
    const barT = root.querySelector<HTMLElement>('[data-bar-t]')!;
    const barOf = root.querySelector<HTMLElement>('[data-bar-of]')!;
    const segs = [...root.querySelectorAll<HTMLElement>('.hs__seg i')];
    const pan = root.querySelector<HTMLElement>('[data-pan]')!;
    const end = root.querySelector<HTMLElement>('[data-end]')!;
    const titles = lis.map((li) => li.querySelector('.hs__lt')?.textContent?.replace(/^\d+\.\s*/, '') ?? '');
    root.querySelector('.hs__list')?.removeAttribute('aria-live');
    const lays = { wide: build(root.querySelector<SVGSVGElement>('.hs__svg--wide')!), tall: build(root.querySelector<SVGSVGElement>('.hs__svg--tall')!) };
    const wideMQ = window.matchMedia('(min-width: 960px)');
    const probe = document.createElement('div');
    probe.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:100svh;visibility:hidden;pointer-events:none';
    root.append(probe);

    let lay = lays.wide, A: number[] = [], ref = 0, cut = 0, barH = 0, winV = 0, scale = 1;
    let pT = 0, pD = 0, panT = 0, panD = 0, raf = 0, step = 0, live: boolean | null = null, force = true, auto = 0;

    const measure = () => {
      lay = wideMQ.matches ? lays.wide : lays.tall;
      const top = parseFloat(getComputedStyle(pin).top) || 0;
      const vh = probe.offsetHeight || window.innerHeight;
      const pinH = pin.offsetHeight;
      barH = bar.offsetHeight;
      const maxWin = wideMQ.matches ? vh - top - 170 : Math.round(vh * 0.55);
      const win = Math.min(pinH, Math.max(maxWin, barH + 180));
      cut = pinH - win;
      winV = win - barH;
      ref = top + win + 12;
      root.style.setProperty('--hs-cut', `${cut}px`);
      root.style.setProperty('--hs-win', `${win}px`);
      root.style.setProperty('--hs-ref', `${ref}px`);
      root.style.setProperty('--hs-endh', `${Math.max(0, top + pinH - ref) + Math.round(vh * 0.35)}px`);
      root.classList.toggle('cut', cut > 0);
      scale = lay.svg.getBoundingClientRect().height / lay.vbH || 1;
      const y = window.scrollY;
      A = [...lis, end].map((el) => el.getBoundingClientRect().top + y);
      force = true;
    };
    // Прогресс 0..9: какая карточка этапа сейчас под линией чтения и насколько она прокручена.
    const target = () => {
      const y = window.scrollY + ref;
      if (y <= A[0]) return 0;
      for (let i = 0; i < 9; i++) if (y < A[i + 1]) return i + (y - A[i]) / (A[i + 1] - A[i]);
      return 9 + Math.min(0.5, (y - A[9]) / 400);
    };
    const yOf = (p: number) => {
      if (p >= 9) return A[9] + (p - 9) * 400 - ref;
      const i = Math.max(0, Math.floor(p));
      return A[i] + (p - i) * (A[i + 1] - A[i]) - ref;
    };

    const setStep = (k: number, isLive: boolean) => {
      for (const L of [lays.wide, lays.tall]) for (const g of L.grps) {
        g.el.classList.toggle('on', !isLive && (k === 9 || g.st.includes(k)));
        g.el.classList.toggle('fut', !isLive && g.min > k);
      }
      lis.forEach((li, i) => li.classList.toggle('on', !isLive && i + 1 === k));
      press(isLive ? null : k);
      root.classList.toggle('live', isLive);
      barN.textContent = isLive ? '9' : String(k);
      barT.textContent = isLive ? 'Весь цикл: обе ветки работают одновременно' : titles[k - 1];
      barOf.textContent = isLive ? "" : `этап ${k} из 9`;
    };

    const render = () => {
      const p = pD;
      const isLive = p >= 9;
      const k = Math.min(9, Math.floor(p) + 1);
      if (force || k !== step || isLive !== live) { step = k; live = isLive; setStep(k, isLive); }
      for (let n = 1; n <= 9; n++) {
        const t = stageT(p, n);
        for (const s of lay.subs[n]) {
          const u = s.b > s.a ? clamp((t - s.a) / (s.b - s.a)) : (t > 0 ? 1 : 0);
          if (force || Math.abs(u - s.u) > 1e-4) { s.u = u; (s.mk ?? s.el).style.strokeDashoffset = String(s.L * (1 - u)); }
        }
      }
      for (const a of lay.arrs) {
        const on = stageT(p, a.st) >= a.tau - 1e-3;
        if (force || on !== a.on) { a.on = on; a.el.style.opacity = on ? '' : '0'; }
      }
      segs.forEach((i, n) => { const f = clamp(p - n); const v = `scaleX(${f.toFixed(3)})`; if (i.style.transform !== v) i.style.transform = v; });
      panT = cut > 0 && !isLive ? clamp(cam(lay, p) * scale - winV / 2, 0, cut) : 0;
      force = false;
    };

    const tick = () => {
      raf = 0;
      const d = pT - pD;
      pD = Math.abs(d) < 0.002 ? pT : pD + d * 0.18;
      render();
      const dp = panT - panD;
      panD = Math.abs(dp) < 0.5 ? panT : panD + dp * 0.2;
      pan.style.transform = panD ? `translate3d(0, ${(-panD).toFixed(1)}px, 0)` : '';
      if (pD !== pT || panD !== panT) raf = requestAnimationFrame(tick);
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };
    const onScroll = () => { pT = target(); kick(); };
    const relayout = () => { measure(); pT = target(); kick(); };

    measure();
    pT = pD = target();
    render();
    panD = panT;
    pan.style.transform = panD ? `translate3d(0, ${(-panD).toFixed(1)}px, 0)` : '';
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', relayout);
    wideMQ.addEventListener('change', () => { relayout(); pD = pT; force = true; render(); });
    new ResizeObserver(() => relayout()).observe(scrolly);
    document.fonts?.ready.then(relayout);
    // Метки потока бегут, только пока схема на экране.
    new IntersectionObserver(([e]) => root.classList.toggle('idle', !e.isIntersecting)).observe(pin);

    // Номер или ссылка «На схеме» - прокрутка к карточке этапа.
    const goTo = (n: number) => { stopAuto(); window.scrollTo({ top: yOf(n - 1 + 0.02), behavior: 'smooth' }); };
    // «Показать весь цикл»: страница прокручивается сама, любое действие посетителя останавливает.
    const stopAuto = () => {
      if (auto) cancelAnimationFrame(auto);
      auto = 0;
      play.setAttribute('aria-pressed', 'false');
      playT.textContent = 'Показать весь цикл';
    };
    const startAuto = () => {
      const p0 = pT > 0.02 && pT < 8.9 ? pT : 0;
      const p1 = 9.15, dur = (p1 - p0) * 1700;
      let t0 = 0;
      window.scrollTo({ top: yOf(p0), behavior: 'instant' as ScrollBehavior });
      play.setAttribute('aria-pressed', 'true');
      playT.textContent = 'Остановить';
      const stepF = (now: number) => {
        if (!t0) t0 = now;
        const f = clamp((now - t0) / dur);
        window.scrollTo({ top: yOf(p0 + (p1 - p0) * f), behavior: 'instant' as ScrollBehavior });
        if (f < 1) auto = requestAnimationFrame(stepF); else stopAuto();
      };
      auto = requestAnimationFrame(stepF);
    };
    const userStop = (e: Event) => { if (auto && !(e.target instanceof Element && e.target.closest('[data-play]'))) stopAuto(); };
    ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach((ev) => window.addEventListener(ev, userStop, { passive: true }));
    play.addEventListener('click', () => (auto ? stopAuto() : startAuto()));
    root.addEventListener('click', (e) => {
      const t = (e.target as Element).closest<HTMLElement | SVGElement>('[data-go]');
      if (!t || !root.contains(t)) return;
      goTo(Number(t.dataset.go));
    });
    document.querySelectorAll<HTMLElement>('[data-go-stage]').forEach((a) =>
      a.addEventListener('click', (e) => { e.preventDefault(); goTo(Number(a.dataset.goStage)); }));
  });
</script>

<style>
  .hs { margin: 0; color: #0F2340; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .hs__top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 24px; padding-bottom: 20px; border-bottom: 3px solid #1E3A5F; }
  .hs__h { font-size: clamp(30px, 3.6vw, 48px); line-height: 1.05; font-weight: 800; letter-spacing: -.025em; }
  .hs__badge { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; border: 2px solid #1E3A5F; font-size: 16px; font-weight: 700; line-height: 1.3; }
  .hs__badge::before { content: ''; width: 0; height: 0; border-left: 11px solid #E2452B; border-top: 7px solid transparent; border-bottom: 7px solid transparent; flex: none; }

  .hs__stage { margin-top: 24px; }
  .hs__svg { width: 100%; height: auto; overflow: visible; }
  .hs__svg--tall { display: none; max-width: 440px; margin: 0 auto; }
  .hs__svg text { font-family: inherit; }
  .hs__svg .p { fill: none; stroke-width: 5; stroke-linejoin: miter; stroke-linecap: butt; }
  .hs__svg .p.r { stroke: #E2452B; }
  .hs__svg .p.a { stroke: #F2A23A; }
  .hs__svg .p.b { stroke: #2B6CD9; }
  .hs__svg .p.d { stroke: #2B6CD9; stroke-width: 3.5; stroke-dasharray: 8 6; }
  .hs__svg .ar { stroke: none; }
  .hs__svg .ar.r { fill: #E2452B; }
  .hs__svg .ar.a { fill: #F2A23A; }
  .hs__svg .ar.b { fill: #2B6CD9; }
  .hs__svg .eq { fill: #fff; stroke: #1E3A5F; stroke-width: 2.5; }
  .hs__svg .fin { fill: none; stroke: #1E3A5F; stroke-width: 1.5; }
  .hs__svg .fl { fill: none; stroke: #E2452B; stroke-width: 2.5; stroke-linejoin: miter; }
  .hs__svg .pump circle { fill: #fff; stroke: #1E3A5F; stroke-width: 2.5; }
  .hs__svg .pump path { fill: none; stroke: #1E3A5F; stroke-width: 2; stroke-linejoin: miter; }
  .hs__svg .t { font-size: 16px; font-weight: 700; fill: #0F2340; }
  .hs__svg .tm { font-size: 15px; font-weight: 600; fill: #2C4466; }
  .hs__svg--tall .t { font-size: 16px; }
  .hs__svg--tall .tm { font-size: 16px; }
  .hs__svg .n circle { fill: #1E3A5F; }
