---
// Схема отопления дома для эскиза C. Логика и связи - по _эскизы/схема-отопления-эталон.svg:
// котёл → гидрострелка → две ПАРАЛЛЕЛЬНЫЕ ветки: (3 насосная группа → 4 коллектор радиаторов → 5 радиаторы)
// и (6 узел смешения → 7 коллектор тёплого пола → 8 петли) → 9 общая обратка через гидрострелку в котёл.
// Подмес идёт только из обратки пола в узел смешения; обратка радиаторов в узел смешения не заходит.
// Две раскладки: широкая (от 960 px) и вертикальная для телефона.
// Без JS и при «уменьшить движение»: схема целиком в цвете, 9 этапов списком, номера подсвечивают этап.
// С JS - прокрутка ведёт по схеме (класс .sc): схема закреплена, под ней прокручиваются карточки этапов,
// трубы прорисовываются по ходу воды (stroke-dashoffset от прогресса прокрутки), после 9 этапа - «живой» режим.
import { clean } from '../../lib/eskiz';
interface Props { hid?: string }
const { hid = 'h-shema' } = Astro.props;

const RED = '#E2452B', AMBER = '#F2A23A', BLUE = '#2B6CD9';
// s - короткий текст карточки при прокрутке, d - подробный текст списка без анимации.
const STAGES_RAW = [
  { n: 1, c: RED, t: 'Котёл', s: 'Котёл нагревает теплоноситель до 60-75 °C', d: 'Нагревает воду до 60-75 °C и отдаёт её в систему.', link: { href: '/otoplenie/kotelnaya/', t: 'Котельная частного дома' } },
  { n: 2, c: RED, t: 'Гидрострелка', s: 'Гидрострелка делит поток на два контура', d: 'Разделяет котёл и контуры дома и делит горячий поток на две параллельные ветки: радиаторы и тёплый пол.', link: { href: '/otoplenie/', t: 'Отопление дома целиком' } },
  { n: 3, c: RED, t: 'Насосная группа прямого контура', s: 'Насосная группа гонит горячую воду к радиаторам', d: 'Насос гонит горячую воду к радиаторам без смешения, с той же температурой, что от котла.' },
  { n: 4, c: RED, t: 'Коллектор радиаторов', s: 'К каждому радиатору своя пара труб, без расходомеров', d: 'Раздаёт воду по радиаторам. Расходомеры здесь не нужны.', link: { href: '/otoplenie/radiatory/', t: 'Радиаторы отопления' } },
  { n: 5, c: BLUE, t: 'Радиаторы, 70/55 °C', s: 'Радиаторы отдают тепло, остывшая вода уходит в обратку', d: 'Вода приходит горячей, отдаёт тепло комнате и остывшей уходит в общую обратку.' },
  { n: 6, c: AMBER, t: 'Узел смешения', s: 'Горячая подача + часть обратки пола = 35-45 °C', d: 'К горячей подаче подмешивает остывшую воду из обратки пола, насос подаёт смесь дальше. В пол не попадает вода горячее 45 °C.', link: { href: '#chto-delaem', t: 'Что делаем на этом узле' } },
  { n: 7, c: AMBER, t: 'Коллектор тёплого пола', s: 'Коллектор тёплого пола с расходомерами на каждой петле', d: 'Раздаёт воду по петлям. На каждой петле расходомер, чтобы комнаты грелись одинаково.', link: { href: '#ceny', t: 'Цены на монтаж' } },
  { n: 8, c: AMBER, t: 'Петли тёплого пола, 35-45 °C', s: 'Петли змейкой греют пол, часть воды возвращается на подмес', d: 'Труба уложена змейкой. Часть остывшей воды возвращается в узел смешения на подмес, остальная уходит в общую обратку.', link: { href: '#kak-rabotaem', t: 'Как укладываем петли' } },
  { n: 9, c: BLUE, t: 'Общая обратка', s: 'Общая обратка через гидрострелку в котёл, цикл повторяется', d: 'Остывшая вода от радиаторов и тёплого пола через гидрострелку возвращается в котёл.', link: { href: '#zayavka', t: 'Рассчитать стоимость' } },
];

const STAGES = STAGES_RAW.map((s) => ({ ...s, t: clean(s.t), s: clean(s.s), d: clean(s.d) }));

// Стрелка направления потока: треугольник с центром в (x, y).
const arr = (x: number, y: number, dir: 'r' | 'l' | 'u' | 'd', s = 7) => {
  const p = { r: [[-s, -s], [s, 0], [-s, s]], l: [[s, -s], [-s, 0], [s, s]], u: [[-s, s], [0, -s], [s, s]], d: [[-s, -s], [0, s], [s, -s]] }[dir];
  return p.map(([dx, dy]) => `${x + dx},${y + dy}`).join(' ');
};
// Рёбра радиатора
const fins = (x: number, y: number, w: number, h: number, step = 8) =>
  Array.from({ length: Math.floor((w - 4) / step) }, (_, i) => `M${x + 6 + i * step} ${y + 6} V${y + h - 6}`).join(' ');
