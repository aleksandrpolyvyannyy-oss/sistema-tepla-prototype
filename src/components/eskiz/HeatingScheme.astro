  .hs__bar, .hs__end, .hs__ls { display: none; }

  /* Список этапов: без JS и при «уменьшить движение» */
  .hs__cap { margin-top: 24px; }
  .hs__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 32px; }
  .hs__list li { border-top: 3px solid var(--sc); }
  .hs__card { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 14px; padding: 16px 0; }
  .hs__ln { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #1E3A5F; color: #fff; font-weight: 800; font-size: 16px; }
