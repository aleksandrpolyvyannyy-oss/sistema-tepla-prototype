  .hs.js .hs__svg .n { cursor: pointer; }
  .hs.js .hs__svg .n:hover circle { fill: #E8662A; }

  /* Подсветка этапа: остальное приглушается */
  .hs__svg [data-stage] { transition: opacity .35s ease; }
  .hs[data-active] .hs__svg [data-stage]:not(.on) { opacity: .16; }
  .hs__svg [data-stage].on .eq { fill: #FFF3E6; stroke-width: 3.5; }
  .hs__svg [data-stage].on .n circle { fill: #E8662A; }
  .hs__svg [data-stage].on .p { stroke-width: 7; }
  .hs__svg [data-stage].on .p.d { stroke-width: 4.5; }

  .hs__legend { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 20px; font-size: 16px; font-weight: 600; }
  .hs__legend li { display: inline-flex; align-items: center; gap: 10px; }
  .hs__legend svg { width: 40px; height: 10px; flex: none; }

  .hs__ctrl { margin-top: 20px; }
  .hs__nums { display: flex; flex-wrap: wrap; gap: 8px; }
  .hs__num, .hs__play { min-height: 48px; border: 2px solid #1E3A5F; background: #fff; color: #0F2340; font-weight: 800; cursor: pointer; border-radius: 0; }
  .hs__num { width: 48px; font-size: 18px; }
  .hs__num[aria-pressed='true'] { background: #1E3A5F; color: #fff; }
  .hs__num:hover { border-color: #E8662A; }
  .hs__play { display: inline-flex; align-items: center; gap: 10px; padding: 0 20px; margin-left: 8px; background: #E8662A; border-color: #E8662A; font-size: 17px; }
