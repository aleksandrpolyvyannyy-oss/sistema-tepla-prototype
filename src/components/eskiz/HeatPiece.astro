<style>
  .kus { margin: 0; background: #fff; color: #0F2340; }
  .kus svg { display: block; width: 100%; height: auto; overflow: visible; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .kus text { font-family: inherit; }
  /* толщина в единицах схемы: 7.5 - около 8 px на компьютере и 6-7 px на телефоне; трубы страницы берут ту же толщину */
  .p { fill: none; stroke-width: 7.5; stroke-linejoin: round; stroke-linecap: butt; }
  .p.r { stroke: #E2452B; } .p.a { stroke: #F2A23A; } .p.b { stroke: #2B6CD9; }
  .p.d { stroke: #2B6CD9; stroke-width: 4.5; stroke-dasharray: 9 7; }
  .ar { stroke: none; transition: opacity .25s; }
  .ar.r { fill: #E2452B; } .ar.a { fill: #F2A23A; } .ar.b { fill: #2B6CD9; }
  .eq { fill: #fff; stroke: #1E3A5F; stroke-width: 2.5; }
  .eq--in { fill: #FFF6EC; stroke-width: 2; }
  .slab { fill: #F3F0E8; stroke: #1E3A5F; stroke-width: 2; }
  .mini-f { fill: none; stroke: #B9C6D8; stroke-width: 2; }
  .flt { fill: #F2A23A; }
  .brn { fill: #1E3A5F; }
  .fl__o { fill: #E2452B; } .fl__i { fill: #F2A23A; }
  .fl { transform-box: view-box; transform-origin: 200px 192px; }
  .pump circle { fill: #fff; stroke: #1E3A5F; stroke-width: 2.5; }
  .pump path { fill: none; stroke: #1E3A5F; stroke-width: 2; stroke-linejoin: miter; }
  .t { font-size: 21px; font-weight: 800; fill: #0F2340; }
  .tb { font-size: 19px; font-weight: 800; fill: #0F2340; }
  .tm { font-size: 18px; font-weight: 600; fill: #2C4466; }
  .n circle { fill: #1E3A5F; }
  .n text { fill: #fff; font-size: 18px; font-weight: 800; text-anchor: middle; }
  .n--s text { font-size: 17.5px; }
  .kus__cap { margin-top: 18px; padding-top: 14px; border-top: 3px solid #2B6CD9; font-size: 18px; line-height: 1.45; font-weight: 600; }
  .kus__cap b { font-weight: 800; }

  /* Состояния, которые ставит скрипт страницы (.zz.an - анимация включена) */
  /* бледные контуры и метки потока созданы скриптом, поэтому :global */
  .kus :global(.pg) { fill: none; stroke: #DCE3EC; stroke-width: 7.5; stroke-linejoin: round; }
  .kus :global(.pg--d) { stroke-width: 4.5; stroke-dasharray: 9 7; }
  .kus :global(.fm) { display: none; fill: none; stroke: #fff; stroke-width: 2.2; stroke-dasharray: 5 21; pointer-events: none; }
  :global(.zz.an) .kus :is(.eq, .t, .tb, .tm, .n, .fl, .brn, .slab, .pump, .flt, .mini-f) { transition: opacity .5s ease; }
  :global(.zz.an) .kus:not(.on) :is(.eq, .t, .tb, .tm, .n, .fl, .brn, .slab, .pump, .flt) { opacity: .32; }
  :global(.zz.an) .kus.on .eq { stroke-width: 3; }
  :global(.zz.an) .kus.vis.fa :global(.fm[data-l='A']),
  :global(.zz.an) .kus.vis.fb :global(.fm[data-l='B']),
  :global(.zz.an.live) .kus.vis :global(.fm) { display: inline; animation: kus-flow 1s linear infinite; }
  :global(.zz.an.live) .kus.vis .p.d, :global(.zz.an) .kus.vis.fa .p.d { animation: kus-mix 1s linear infinite; }
  :global(.zz.an) .kus.on.vis .fl { animation: kus-fire 1.6s ease-in-out infinite; }
  @keyframes kus-flow { from { stroke-dashoffset: 26; } to { stroke-dashoffset: 0; } }
  @keyframes kus-mix { from { stroke-dashoffset: 16; } to { stroke-dashoffset: 0; } }
  @keyframes kus-fire { 0%, 100% { transform: scale(1, 1); } 30% { transform: scale(.94, 1.07); } 60% { transform: scale(1.04, .95); } }
  @media (max-width: 760px) { .kus__cap { font-size: 17px; } }
</style>
