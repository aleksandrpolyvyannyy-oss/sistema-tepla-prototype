        <rect class="eq eq--in" x="140" y="106" width="120" height="98" />
        <g class="fl">
          <path class="fl__o" d="M200 120 C210 138 230 150 228 170 C226 186 214 192 200 192 C186 192 172 186 172 170 C172 156 182 150 186 136 C192 148 196 152 200 158 C204 146 206 134 200 120 Z" />
          <path class="fl__i" d="M200 150 C208 162 216 168 214 178 C212 187 206 190 200 190 C193 190 186 186 186 178 C186 170 194 166 200 150 Z" />
        </g>
        <rect class="brn" x="156" y="193" width="88" height="6" />
        <text class="t" x="200" y="242" text-anchor="middle">нагрев 60-75 °C</text>
        <text class="tm" x="168" y="330" text-anchor="end">подача</text>
