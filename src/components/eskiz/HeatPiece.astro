---
// Кусок схемы отопления для эскиза C «зигзаг»: в каждом разделе страницы своя часть системы.
// Все куски шириной 400 в координатах схемы. Две трубы входят сверху и выходят снизу в одних и тех же точках:
// A (по ходу воды: подача, после смешения тёплая, после петель остывшая) x=180, B (обратка в котёл, вверх) x=220.
// Через эти точки трубы страницы (слой на всю высоту, рисует скрипт страницы) переходят из куска в кусок.
// Разметка для скрипта: path.p[data-l][data-a][data-b] - труба, прорисовывается, когда вода прошла долю a..b куска;
// data-l: A - вода сверху вниз по странице, B - обратка, M - мини-схема всего контура (раздел 06).
// .ar[data-l][data-at] - стрелка потока, загорается на доле at. Без JS всё нарисовано целиком в цвете.
import { roundPath, type Pt } from '../../lib/eskiz-pipes';
interface Props { k: 'kotel' | 'strelka' | 'smes' | 'kollektor' | 'petli' | 'podmes' | 'obratka'; label: string }
const { k, label } = Astro.props;

const H = { kotel: 400, strelka: 460, smes: 440, kollektor: 460, petli: 460, podmes: 420, obratka: 520 }[k];
const rp = (pts: Pt[], r = 16) => roundPath(pts, r).d;
// Стрелка потока: треугольник с центром в (x, y).
const arr = (x: number, y: number, dir: 'r' | 'l' | 'u' | 'd', s = 8) => {
  const p = { r: [[-s, -s], [s, 0], [-s, s]], l: [[s, -s], [-s, 0], [s, s]], u: [[-s, s], [0, -s], [s, s]], d: [[-s, -s], [0, s], [s, -s]] }[dir];
  return p.map(([dx, dy]) => `${x + dx},${y + dy}`).join(' ');
};
// Обратка в котёл справа от оборудования: снизу вверх с обходом по правому краю.
const bypass = (yLow: number, yHigh: number) => rp([[220, H], [220, yLow], [372, yLow], [372, yHigh], [220, yHigh], [220, 0]], 16);
---
<figure class="kus" data-kus data-k={k}>
  <svg viewBox={`0 0 400 ${H}`} aria-hidden="true" focusable="false">
    {k === 'kotel' && (
      <>
        <path class="p r" data-l="A" data-a="0" data-b="1" d="M180 266 V400" />
        <path class="p b" data-l="B" data-a="0" data-b="1" d="M220 400 V266" />
        <polygon class="ar r" data-l="A" data-at=".5" points={arr(180, 336, 'd')} />
