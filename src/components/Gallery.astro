---
import { Image } from 'astro:assets';
import { photo, PHOTO_ALT } from '../lib/photos';
// strip — компактная лента в одну строку (на телефоне — карусель), без большого первого кадра.
interface Props { ids: string[]; strip?: boolean }
const { ids, strip = false } = Astro.props;
---
<div class:list={['gallery', { 'gallery--strip rail': strip }]} style={strip ? `--n:${ids.length}` : undefined}>
  {ids.map((id, i) => (
    <figure>
      {strip
        ? <Image src={photo(id)} alt={PHOTO_ALT[id] ?? ''} widths={[240, 400]} sizes="(max-width: 720px) 62vw, 200px" />
        : <Image src={photo(id)} alt={PHOTO_ALT[id] ?? ''} widths={i === 0 ? [480, 800] : [320, 480]} sizes={i === 0 ? '(max-width: 720px) 100vw, 600px' : '(max-width: 720px) 50vw, 300px'} />}
      <figcaption>{PHOTO_ALT[id]}</figcaption>
    </figure>
  ))}
</div>
