---
// Карточка объекта. Фото по объектам пока нет: данные карточек примерные, чужие фото к ним не ставим (ФОТО-КАРТА.md) — вместо обложки заглушка.
import PhotoNeeded from './PhotoNeeded.astro';
import { NEED } from '../data/photo-needs';
import type { Obj } from '../data/objects';
interface Props { o: Obj }
const { o } = Astro.props;
---
<a class="obj" href={`/obekty/${o.slug}/`} data-tags={o.tags.join(' ')}>
  <div class="obj__img">
    <PhotoNeeded text={NEED.obekty} variant="card" />
    <span class="obj__place">{o.district}</span>
  </div>
  <div class="obj__body">
    <h3>{o.title}</h3>
    <div class="obj__params"><span>{o.area} м²</span><span>{o.walls}</span><span>{o.term}</span></div>
    <div class="obj__budget">{o.budget}</div>
  </div>
</a>
