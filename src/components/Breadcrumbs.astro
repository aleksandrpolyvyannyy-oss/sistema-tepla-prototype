---
import JsonLd from './JsonLd.astro';
import { SITE } from '../data/site';
interface Props { items: { href: string; label: string }[] }
const all = [{ href: '/', label: 'Главная' }, ...Astro.props.items];
const ld = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: new URL(c.href, SITE.url).href })),
};
---
<nav class="crumbs wrap" aria-label="Хлебные крошки">
  <ol>
    {all.map((c, i) => i < all.length - 1 ? <li><a href={c.href}>{c.label}</a></li> : <li aria-current="page">{c.label}</li>)}
  </ol>
</nav>
<JsonLd data={ld} />
