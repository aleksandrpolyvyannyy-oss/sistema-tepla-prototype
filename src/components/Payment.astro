---
import { PAYMENT } from '../data/common';
---
<div class="pay__bar" aria-hidden="true"><i style="width:70%;background:var(--blue)"></i><i style="width:20%;background:var(--amber)"></i><i style="width:10%;background:var(--red)"></i></div>
<div class="pay">
  {PAYMENT.map((p) => <div class="pay__item"><div class="pay__pct">{p.pct}</div><h3 style="margin:10px 0 6px">{p.t}</h3><p class="muted" style="margin:0">{p.d}</p></div>)}
</div>
