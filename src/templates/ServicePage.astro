---
// Ш2 — страница услуги (хаб раздела, подуслуга, SEO-страница вне меню).
// Под первым экраном — липкое меню разделов. Основной текст (вводные абзацы и разделы) берётся из content/<ключ>.json
// или из дефолтов страницы. У «Канализации» под первым экраном особая раскладка (PRAVKI-V2.md, п. 3).
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DirectAnswer from '../components/DirectAnswer.astro';
import SectionNav from '../components/SectionNav.astro';
import Section from '../components/Section.astro';
import Packages from '../components/Packages.astro';
import PriceTable from '../components/PriceTable.astro';
import Quiz from '../components/Quiz.astro';
import Compare from '../components/Compare.astro';
import ObjectsGrid from '../components/ObjectsGrid.astro';
import Steps from '../components/Steps.astro';
import Guarantees from '../components/Guarantees.astro';
import Faq from '../components/Faq.astro';
import Related from '../components/Related.astro';
import Reviews from '../components/Reviews.astro';
import LeadSection from '../components/LeadSection.astro';
import Expand from '../components/Expand.astro';
import Prose from '../components/Prose.astro';
import AlsoLinks from '../components/AlsoLinks.astro';
import KanalTiles from '../components/KanalTiles.astro';
import SepticPicker from '../components/SepticPicker.astro';
import SepticTable from '../components/SepticTable.astro';
import { type Page, pageBySlug, href, crumbsFor, serviceLd } from '../data/pages';
import { STEPS_MONTAGE } from '../data/common';
interface Props { page: Page }
const { page: p } = Astro.props;
const isKanal = p.slug === 'kanalizaciya';
// Посадочные канализации с подбором станции (PRAVKI-V2.md, п. 3а).
const hasPicker = isKanal || !!p.picker;
const inKanal = p.slug.startsWith('kanalizaciya');
const children = (p.children ?? []).map((s) => pageBySlug(s)!).filter(Boolean);
const eyebrow = p.eyebrow ?? `${p.kind === 'hub' ? 'Раздел' : 'Услуга'} · СПб и Ленобласть`;
// У хаба сравнение вариантов живёт в блоке «что выбрать», у дочерней — отдельным разделом после калькулятора.
const hasChoice = children.length > 0 && !isKanal;
const hasAlso = (p.also ?? []).length > 0;
const compareInChoice = hasChoice && !!p.compare;
const compareOwn = !hasChoice && !!p.compare;
const hasText = (p.intro ?? []).length > 0 || (p.sections ?? []).length > 0;
const nav = [
  isKanal && { id: 'proizvoditeli', label: 'Производители' },
  hasPicker && { id: 'podbor', label: 'Подбор станции' },
  p.picker && { id: 'modeli', label: 'Модели' },
  hasChoice && { id: 'vybor', label: 'Что выбрать' },
  hasText && { id: 'podrobno', label: 'Подробно' },
  p.anchors && { id: 'vidy', label: 'Виды работ' },
  { id: 'ceny', label: 'Цены' },
  { id: 'raschet', label: 'Расчёт' },
  compareOwn && { id: 'varianty', label: 'Сравнение' },
  { id: 'obekty', label: 'Объекты' },
  { id: 'etapy', label: 'Этапы и сроки' },
  { id: 'garantii', label: 'Гарантии' },
  { id: 'otzyvy', label: 'Отзывы' },
  { id: 'voprosy', label: 'Вопросы' },
].filter(Boolean) as { id: string; label: string }[];
---
<Base title={p.title} description={p.description} crumbs={crumbsFor(p.slug)} jsonld={[serviceLd(p)]} quiz>
  <Hero h1={p.h1} offer={p.offer} price={p.priceFrom} img={p.hero} facts={p.facts} factsTitle={p.name} eyebrow={eyebrow}>
    {p.anchors && (
      <nav class="anchor-nav" aria-label="Виды работ" style="margin:0 0 20px">
        {p.anchors.map((a) => <a class="chip" href={`#${a.id}`}>{a.title}</a>)}
      </nav>
    )}
  </Hero>
  <DirectAnswer text={p.answer} />
  <SectionNav items={nav} />

  {isKanal && <KanalTiles brands={p.children ?? []} />}
  {hasPicker && <SepticPicker preset={p.picker} title={isKanal ? 'Подбор станции' : `Подбор станции: ${p.name.toLowerCase()}`} />}
  {p.picker && <SepticTable filter={p.picker} />}

  {hasChoice && (
    <Section id="vybor" eyebrow="Разделы" title={`${p.name}: что выбрать`}>
      <div class:list={['grid', children.length === 4 ? 'grid--4' : 'grid--3']}>
        {children.map((c) => (
          <a class="card card--link" href={href(c.slug)}>
            <h3>{c.name}</h3>
            <p class="muted" style="margin:0">{c.offer}</p>
            <div class="card__price">{c.priceFrom}</div>
          </a>
        ))}
      </div>
      <AlsoLinks slugs={p.also} />
      {compareInChoice && (
        <div class="mt-40">
          <h3>{p.compare!.title}</h3>
          <Compare head={p.compare!.head} rows={p.compare!.rows} />
        </div>
      )}
    </Section>
  )}

  <Prose intro={p.intro} sections={p.sections} subs={p.subs} updated={p.updated} draft={p.draft} variant={hasChoice || !!p.picker ? 'tint' : 'plain'} />

  {p.anchors && (
    <Section id="vidy" variant="tint" eyebrow="Виды работ" title={`${p.name}: виды работ и цены`}>
      <div class="kinds">
        {p.anchors.map((a) => (
          <div class="kind" id={a.id}>
            <div>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </div>
            <PriceTable rows={a.prices} caption={a.title} note={false} />
          </div>
        ))}
      </div>
    </Section>
  )}

  <Section id="ceny" eyebrow="Цены и состав работ" title={p.packages ? 'Цены: пакеты под ключ и прайс работ' : 'Цены на работы и что в них входит'} lead="Цены «от» — ориентир. Точную стоимость дадим сметой после замера и зафиксируем в договоре.">
    {p.packages && <Packages items={p.packages} />}
    <div class={p.packages ? 'mt-40' : ''}>
      <PriceTable rows={p.prices} includes={p.includes} brands={p.brands} />
    </div>
    {!hasChoice && hasAlso && <AlsoLinks slugs={p.also} />}
  </Section>

  <Quiz preset={p.quiz} />

  {compareOwn && (
    <Section id="varianty" eyebrow="Варианты решений" title={p.compare!.title}>
      <Compare head={p.compare!.head} rows={p.compare!.rows} />
    </Section>
  )}

  <ObjectsGrid tags={p.objTags} strict={p.kind === 'secondary' || inKanal} variant={compareOwn ? 'tint' : 'plain'} gallery={p.gallery} />

  <Section id="etapy" variant={compareOwn ? 'plain' : 'tint'} eyebrow="Этапы и сроки" title="Как мы работаем: этапы и сроки" lead="Сроки каждого этапа — в графике к договору.">
    <Expand h={640} mobileOnly label="Показать все этапы">
      <Steps items={p.steps ?? STEPS_MONTAGE} />
    </Expand>
    <div class="prep">
      <h3>Что должно быть готово в доме</h3>
      <Expand h={200} mobileOnly label="Показать весь список">
        <ul class="checklist">{p.checklist.map((c) => <li>{c}</li>)}</ul>
      </Expand>
    </div>
  </Section>

  <Guarantees eyebrow="Почему нам доверяют" title="Гарантии, оплата по этапам и прозрачная смета" payment estimate={p.quiz} />

  <Reviews />
  <Faq items={p.faq} variant="tint" />
  <Related slugs={p.related} links={p.relatedLinks} />
  <LeadSection />
</Base>
